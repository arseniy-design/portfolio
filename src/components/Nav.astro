---
/**
 * Site navigation, shared by every page. Redesigned 2026-09-23.
 * Rule: every link goes to a page, never to a scroll point on the homepage.
 * Bigger than before, pinned on scroll, with a real Home link.
 *
 * current  which page is open (marks the active link)
 * tone     dark = charcoal bar (Home, Work), light = white bar (Services, Writing)
 * fixed    kept for older pages; the bar is always pinned now
 * cta      where "Work with me" goes: the form on this page if it has one
 */
interface Props {
  current?: 'home' | 'work' | 'services' | 'writing';
  tone?: 'dark' | 'light';
  fixed?: boolean;
  cta?: string;
}
const { current, tone = 'dark', cta = '/services#talk' } = Astro.props;
const LINKS = [
  { key: 'home',     label: 'Home',     href: '/' },
  { key: 'work',     label: 'Work',     href: '/work' },
  { key: 'services', label: 'Services', href: '/services' },
  { key: 'writing',  label: 'Writing',  href: '/writing' },
];
---
<header class="nav" data-tone={tone}>
  <div class="nav-in">
    <a href="/" class="mark" aria-label="Arseniy Goldberg, home">AG<i>.</i></a>
    <nav class="links" aria-label="Site">
      {LINKS.map(l => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a href={cta} class="cta">Work with me</a>
    <button type="button" class="burger" id="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu"><span></span></button>
  </div>
  <div class="menu" id="nav-menu" hidden>
    {LINKS.map(l => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
  </div>
</header>

<script>
  const b = document.getElementById('nav-burger');
  const m = document.getElementById('nav-menu');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(open));
    if (m) m.hidden = !open;
  });
</script>

<style>
  .nav {
    --bg: #FFFFFF; --fg: #111214; --mute: #5E636B; --line: #E6E5E2; --acc: #A8322D; --acc-t: #A8322D;
    position: sticky; top: 0; z-index: 60; background: var(--bg); border-bottom: 1px solid var(--line);
    font-family: 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif;
  }
  .nav[data-tone="dark"] { --bg: #1E1F22; --fg: #F4F3F0; --mute: #AEB1B6; --line: #36383C; --acc-t: #E5484D; }
  .nav-in { max-width: 1180px; margin: 0 auto; height: 78px; padding-inline: 40px; display: flex; align-items: center; gap: 36px; }
  .mark { font-weight: 800; font-size: 22px; letter-spacing: .02em; color: var(--fg); text-decoration: none; }
  .mark i { font-style: normal; color: var(--acc-t); }
  .links { display: flex; gap: 30px; margin-left: auto; }
  .links a { font-family: 'Satoshi', 'Helvetica Neue', Arial, sans-serif; font-size: 16.5px; font-weight: 600; color: var(--mute); text-decoration: none; padding: 8px 0; position: relative; }
  .links a:hover, .links a[aria-current="page"] { color: var(--fg); }
  .links a[aria-current="page"]::after { content: ""; position: absolute; inset: auto 0 0 0; height: 2px; background: var(--acc-t); }
  .cta { display: inline-flex; align-items: center; background: var(--acc); color: #fff; border-radius: 999px; font-family: 'Satoshi', 'Helvetica Neue', Arial, sans-serif; font-weight: 700; font-size: 16px; padding: 14px 24px; text-decoration: none; white-space: nowrap; transition: filter .15s; }
  .cta:hover { filter: brightness(1.08); }
  .burger { display: none; margin-left: auto; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 12px; background: none; align-items: center; justify-content: center; cursor: pointer; }
  .burger span { display: block; width: 18px; height: 2px; background: var(--fg); box-shadow: 0 6px 0 var(--fg), 0 -6px 0 var(--fg); }
  .menu { border-top: 1px solid var(--line); padding: 8px 20px 16px; display: grid; }
  .menu[hidden] { display: none; }
  .menu a { font-family: 'Satoshi', 'Helvetica Neue', Arial, sans-serif; color: var(--mute); text-decoration: none; font-weight: 600; font-size: 18px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .menu a[aria-current="page"] { color: var(--fg); }
  :focus-visible { outline: 2px solid var(--acc-t); outline-offset: 3px; }
  @media (max-width: 760px) {
    .nav-in { height: 66px; padding-inline: 20px; gap: 12px; }
    .links { display: none; }
    .burger { display: flex; margin-left: 0; }
    .cta { margin-left: auto; padding: 11px 16px; font-size: 14px; }
    .mark { font-size: 19px; }
  }
</style>
