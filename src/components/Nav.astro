---
/**
 * Site navigation, shared by every page.
 * Rule: every link goes to a page, never to a scroll point on the homepage.
 *
 * current  which page is open (marks the active link)
 * tone     dark = white text (navy pages), light = ink text (white pages)
 * fixed    float over the hero and darken on scroll (homepage only)
 * cta      where "Let's Talk" goes: the form on this page if it has one
 */
interface Props {
  current?: 'home' | 'work' | 'services' | 'writing';
  tone?: 'dark' | 'light';
  fixed?: boolean;
  cta?: string;
}
const { current, tone = 'dark', fixed = false, cta = '/services#talk' } = Astro.props;
const LINKS = [
  { key: 'work',     label: 'Work',     href: '/work' },
  { key: 'services', label: 'Services', href: '/services' },
  { key: 'writing',  label: 'Writing',  href: '/writing' },
];
---
<nav id="navbar" class:list={['nav', { 'is-fixed': fixed }]} data-tone={tone} aria-label="Site">
  <div class="nav-in">
    <a href="/" class="nav-brand" aria-label="Arseniy Goldberg, home" aria-current={current === 'home' ? 'page' : undefined}>
      <svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <text x="1" y="24" fill="currentColor" style="font-family:var(--font-display);font-weight:700;font-size:25px;letter-spacing:4px">AG</text>
        <text x="53" y="24" fill="#F4621F" style="font-family:var(--font-display);font-weight:700;font-size:25px">.</text>
      </svg>
    </a>

    <div class="nav-links">
      {LINKS.map(l => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href={cta} class="nav-cta">Work with me</a>
    </div>

    <button type="button" class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <div class="nav-menu" id="nav-menu" hidden>
    {LINKS.map(l => (
      <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={cta} class="nav-cta">Work with me</a>
  </div>
</nav>

<style>
  .nav {
    --nav-fg: rgba(255,255,255,0.62); --nav-fg-on: #fff; --nav-brand: #fff;
    --nav-menu-bg: rgba(8,15,22,0.95); --nav-rule: rgba(255,255,255,0.10);
    --nav-cta-bg: #F4621F; --nav-cta-bg-on: #d9530f; --nav-cta-fg: #fff;
    position: relative; z-index: 50; padding: 1rem 1rem; font-family: var(--font-display);
    transition: background 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease;
  }
  .nav[data-tone="light"] {
    --nav-fg: #6A6F76; --nav-fg-on: #0B0B0B; --nav-brand: #0B0B0B;
    --nav-menu-bg: rgba(255,255,255,0.97); --nav-rule: #E4E6E9;
    --nav-cta-bg: #0B0B0B; --nav-cta-bg-on: #333; --nav-cta-fg: #fff;
  }
  .nav.is-fixed { position: fixed; top: 0; left: 0; right: 0; }
  .nav.is-fixed.scrolled {
    background: rgba(8,15,22,0.93); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(255,255,255,0.06); padding-top: 0.875rem; padding-bottom: 0.875rem;
  }
  @media (min-width: 640px) { .nav { padding-left: 2rem; padding-right: 2rem; } }

  .nav-in { max-width: 72rem; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
  .nav-brand { display: flex; align-items: center; color: var(--nav-brand); }

  .nav-links { display: none; align-items: center; gap: 2rem; }
  @media (min-width: 768px) { .nav-links { display: flex; } }
  .nav-links a, .nav-menu a { font-size: 0.875rem; font-weight: 500; color: var(--nav-fg); transition: color 0.2s; text-decoration: none; }
  .nav-links a:hover, .nav-menu a:hover { color: var(--nav-fg-on); }
  .nav-links a[aria-current="page"], .nav-menu a[aria-current="page"] { color: var(--nav-fg-on); font-weight: 600; }

  .nav a.nav-cta {
    background: var(--nav-cta-bg); color: var(--nav-cta-fg); font-weight: 600;
    padding: 0.625rem 1.25rem; border-radius: 999px; transition: background 0.2s;
  }
  .nav a.nav-cta:hover { background: var(--nav-cta-bg-on); color: var(--nav-cta-fg); }

  .nav-burger { display: inline-flex; background: none; border: 0; padding: 0; color: var(--nav-fg); cursor: pointer; }
  .nav-burger:hover { color: var(--nav-fg-on); }
  @media (min-width: 768px) { .nav-burger { display: none; } }

  .nav-menu {
    position: absolute; top: 100%; left: 0; right: 0; display: flex; flex-direction: column; gap: 1rem;
    padding: 1.25rem 1rem; background: var(--nav-menu-bg); border-top: 1px solid var(--nav-rule);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .nav-menu[hidden] { display: none; }
  .nav-menu a.nav-cta { text-align: center; padding: 0.75rem 1.25rem; }
  @media (min-width: 768px) { .nav-menu { display: none; } }
</style>

<script>
  const nav = document.getElementById('navbar');
  const burger = document.getElementById('nav-burger');
  const menu = document.getElementById('nav-menu');

  if (nav?.classList.contains('is-fixed')) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 60);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  burger?.addEventListener('click', () => {
    const open = menu?.toggleAttribute('hidden') === false;
    burger.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.setAttribute('hidden', '');
    burger?.setAttribute('aria-expanded', 'false');
  }));
</script>
