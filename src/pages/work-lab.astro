---
import Layout from '../layouts/Layout.astro';

// PROTOTYPE of a restructured Work section. Not linked from anywhere, noindex.
// One card frame, seven cards, two labelled groups, no tabs.
// Contents deliberately vary between cards; only the frame is constant.

const CLASSROOM = [
  {
    name: "Finance",
    line: "Built on the $1.6B book I managed at Baird, brought straight into the classroom.",
    stats: [["$1.6B","Real-world AUM"],["300+","Sessions delivered"],["6","Courses"]],
    courses: [["Capital Markets","25 Sessions"],["Corporate Finance","15 Sessions"],["Financial Consulting","15 Sessions"],["AI-Powered Finance","15 Sessions"],["Financial Markets & Fintech","15 Sessions"],["Advanced Financial Management","15 Sessions"]],
    links: [
      { tag: "Interactive Hub", name: "Capital Markets Hub · 22 Activities", href: "https://arseniygoldberg.com/capital-markets" },
      { tag: "Course Portfolio", name: "Finance Modules · 50 Video Lessons", href: "https://arseniyportfolio.my.canva.site/arseniy-goldberg-finance-mba-portfolio" },
    ],
    videos: [
      { vid: "1175592384", title: "Time Value of Money" },
      { vid: "1175592202", title: "Working Capital" },
      { vid: "1175592624", title: "Dynamic Valuation" },
      { vid: "1175592738", title: "Sources of Corporate Financing" },
    ],
  },
  {
    name: "Entrepreneurship & AI",
    line: "Five ventures built from scratch across six countries. Founder experience, taught first-hand.",
    stats: [["5","Ventures built"],["5","Innovation programs"],["3","Continents"]],
    courses: [["Entrepreneurial Journey","15 Sessions"],["Design Thinking","8 Sessions"],["Customer Experience","10 Sessions"],["AI as a Cofounder","3 Sessions"],["Business Applications of AI","12 Sessions"],["AI for Productivity","5 Sessions"]],
    videos: [
      { vid: "1175612851", title: "Intro to Entrepreneurship" },
      { vid: "1175612955", title: "Startup Culture" },
      { vid: "1175612878", title: "Lean Startup" },
      { vid: "1175612914", title: "Product Prototyping" },
    ],
  },
  {
    name: "Behavioral Sciences",
    line: "How bias shows up in professional decisions. Applied across finance, leadership, and AI adoption.",
    stats: [["6","Courses"],["3","Live simulations"],["5+","Industries"]],
    courses: [["Critical Skills for the Modern World","15 Sessions"],["Critical Thinking in the AI Era","8 Sessions"],["Decision Making","8 Sessions"],["Financial Behavior","8 Sessions"],["Complex Problem Solving","5 Sessions"],["AI for Professors","Up to 5 Sessions"]],
    links: [
      { tag: "Custom GPT", name: "Telecomm AI Quick Case", href: "https://chatgpt.com/g/g-67583b3565cc819191dadde542a09a5f-telecommunications-ai-quick-case" },
      { tag: "Custom GPT", name: "Telecomm Decision-Making Simulator", href: "https://chatgpt.com/g/g-67581efa33bc8191ad199d44d44cd04f-telecommunications-decision-making-simulator" },
      { tag: "Claude Artifact", name: "The War Room", href: "https://claude.ai/public/artifacts/b3f7ebf5-4457-4860-9436-ecd6483d46d5" },
      { tag: "Claude Artifact", name: "Decision Making", href: "https://claude.ai/public/artifacts/21a50228-9db5-4de6-b0f5-3d231f9159ee" },
    ],
  },
];

const FIELD = [
  {
    name: "Innovation Programs",
    line: "Five programs built and run across three continents, from Azerbaijan to Saudi Arabia to Spain.",
    stats: [["5","Programs"],["3","Continents"],["€250k","Pilot funding"]],
    photo: { src: "/innovation-stage.webp", caption: "BakuID · Startups of Tomorrow" },
    list: { label: "Programs", items: [
      { name: "RCU Scale-up Hub", meta: "Saudi Arabia · 2024", href: "/rcu-scale-up-hub.pdf" },
      { name: "SABAH Hub", meta: "Azerbaijan", href: "https://sabahhub.com/" },
      { name: "Changemakers Program", meta: "Switzerland", href: "https://www.wyssacademy.org/en/changemakers-program" },
      { name: "Science Connexion & Blue Lab", meta: "Mexico", href: "https://scienceconnexion.com/Convocatorias/SobreReto/6" },
      { name: "Santander Innovators 90", meta: "Spain · 2026", href: "https://app.santanderopenacademy.com/en/program/innovation-and-ai-experience-in-madrid" },
    ]},

  },
  {
    name: "AI in Practice",
    line: "GenAI tools built for real professional contexts, from classroom simulations to client intelligence.",
    stats: [["8","Client deliverables"],["4","Walkthroughs"],["5","Platforms"]],
    videos: [
      { vid: "1175529346", title: "AI + Excel" },
      { vid: "1175529293", title: "Claude + Excel" },
      { vid: "1175530353", title: "Perplexity + Finance" },
      { vid: "1175532671", title: "NotebookLM" },
    ],
    links: [
      { tag: "Program", name: "Santander Innovation AI Experience", href: "https://flow-ag.notion.site/santander-innovation-ai-experience" },
      { tag: "Web App", name: "Gate Check", href: "https://si90-gate-check.onrender.com/" },
      { tag: "Sales Tool", name: "Finance Academy Navigator", href: "https://claude.ai/code/artifact/baf9a827-77cd-4045-8950-6fa5e8720d73" },
      { tag: "Perplexity", name: "Taif Market Entry", href: "https://taifmarketentry.pplx.app" },
      { tag: "Perplexity", name: "Hormuz Shock", href: "https://hormuzshock.pplx.app" },
      { tag: "Perplexity", name: "Portfolio Risk Analysis", href: "https://portfolioanalysis.pplx.app" },
      { tag: "Perplexity", name: "Macro Risk Intelligence", href: "https://macrorisks.pplx.app" },
      { tag: "Client Bundle", name: "Delta Dossier", href: "/delta-dossier/" },
    ],
  },
  {
    name: "Digital Courses",
    line: "Three fully-produced courses built for Rebundle's WhatsApp platform, delivered as conversational micro-lessons.",
    stats: [["3","Courses produced"],["100%","Mobile-native"],["1","Platform"]],
    phones: [
      { vid: "1175515603", tag: "AI", name: "Generative AI for Business Professionals" },
      { vid: "1175515477", tag: "Analytics", name: "Digital Analytics for Business Professionals" },
      { vid: "1175515542", tag: "Wellbeing", name: "Mental Health in the Digital Era" },
    ],
  },
];
---

<Layout title="Work section prototype" noindex={true}>
  <style>
    .lab-bar { background:#F4621F; color:#fff; font-family:var(--font-display); font-weight:700;
      font-size:0.72rem; letter-spacing:0.18em; text-transform:uppercase; padding:10px 20px; }
    .wcard { background:#fff; border:1px solid #EDE8DF; border-radius:1rem; padding:1.75rem; display:flex; flex-direction:column; gap:1.4rem; }
    .wcard-dark { background:linear-gradient(158deg,#132133 0%,#0D1B2A 55%,#0A1522 100%); border-color:rgba(255,255,255,0.09); }
    .wcard-dark .wsub { color:rgba(255,255,255,0.72); }
    .wcard-dark .text-navy-900 { color:#fff; }
    .wcard-dark .text-navy-800 { color:#fff; }
    .wcard-dark .text-navy-500 { color:rgba(255,255,255,0.88); }
    .wcard-dark .text-navy-400 { color:rgba(255,255,255,0.78); }
    .wcard-dark .text-navy-300 { color:rgba(255,255,255,0.72); }
    .wcard-dark .divide-warm-100 > :not([hidden]) ~ :not([hidden]) { border-color:rgba(255,255,255,0.08); }
    .wcard-dark .border-warm-200 { border-color:rgba(255,255,255,0.13); }
    .wcard-dark a.border-warm-200:hover { border-color:rgba(244,98,31,0.6); }
    .wlabel { font-family:var(--font-display); font-size:0.68rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#F4621F; }
    .wsub   { font-family:var(--font-display); font-size:0.62rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:#7D99B8; }
  </style>

  <div class="lab-bar">Prototype · not live · the real page is unchanged</div>

  <section class="py-20" style="background:#F4F1EC">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">

      <div class="mb-4 flex items-center gap-3">
        <div style="width:32px;height:2px;background:#F4621F"></div>
        <span class="wlabel">The Work</span>
      </div>
      <h2 class="font-bold text-navy-900 leading-tight mb-14" style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem)">
        Everything, on one page.
      </h2>

      <div class="flex flex-wrap gap-2 mb-10">
        <button type="button" id="tg-classroom" class="wtoggle px-6 py-3 rounded-xl text-sm font-bold transition-all"
          style="font-family:var(--font-display);background:#0D1B2A;color:#fff;border:1px solid #0D1B2A;cursor:pointer">In the Classroom</button>
        <button type="button" id="tg-field" class="wtoggle px-6 py-3 rounded-xl text-sm font-bold transition-all"
          style="font-family:var(--font-display);background:#F4F1EC;color:#5B7494;border:1px solid #EDE8DF;cursor:pointer">In the Field</button>
      </div>

      {[["In the Classroom", CLASSROOM, "classroom"], ["In the Field", FIELD, "field"]].map(([groupName, cards, tone]) => (
        <div class={`wgroup ${tone === "field" ? "hidden" : ""}`} data-group={tone}>

          <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5 items-stretch">
            {cards.map((c, ci) => (
              <div class={`wcard ${ci === 0 ? "wcard-dark" : ""}`}>
                {/* identity */}
                <div>
                  <span class="wlabel block mb-2">{groupName}</span>
                  <h3 class="text-navy-900 mb-3" style="font-family:var(--font-display);font-size:clamp(1.35rem,2vw,1.7rem);font-weight:700;line-height:1.08;letter-spacing:-0.01em">{c.name}</h3>
                  <p class="text-navy-500" style="font-size:0.92rem;line-height:1.55">{c.line}</p>
                </div>

                {/* numbers */}
                <div class="flex flex-wrap pb-1" style="column-gap:1.9rem;row-gap:0.75rem">
                  {c.stats.map(([n, l]) => (
                    <div class="flex-shrink-0">
                      <p class="font-bold text-navy-900 text-xl leading-none" style="font-family:var(--font-display)">{n}</p>
                      <p class="text-navy-400 text-[0.7rem] mt-1 whitespace-nowrap" style="font-family:var(--font-display)">{l}</p>
                    </div>
                  ))}
                </div>

                {c.courses && (
                  <div>
                    <span class="wsub block mb-3">Courses</span>
                    <div class="flex flex-col divide-y divide-warm-100">
                      {c.courses.map(([n, meta]) => (
                        <div class="flex items-start justify-between gap-4 py-2.5">
                          <span class="text-navy-800" style="font-family:var(--font-display);font-size:0.98rem;font-weight:500;line-height:1.35">{n}</span>
                          <span class="text-navy-300 flex-shrink-0" style="font-family:var(--font-display);font-size:0.75rem;line-height:1.35;padding-top:0.08rem">{meta}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {c.list && (
                  <div>
                    <span class="wsub block mb-3">{c.list.label}</span>
                    <div class="flex flex-col divide-y divide-warm-100">
                      {c.list.items.map(p => (
                        <a href={p.href} target="_blank" rel="noopener" class="flex items-start justify-between gap-4 py-2.5 group">
                          <span class="text-navy-800 group-hover:text-orange-500 transition-colors" style="font-family:var(--font-display);font-size:0.98rem;font-weight:500;line-height:1.35">{p.name}</span>
                          <span class="text-navy-300 flex-shrink-0" style="font-family:var(--font-display);font-size:0.75rem;line-height:1.35;padding-top:0.08rem">{p.meta}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {(c.videos || c.pills || c.links || c.phones) && (
                  <div>
                    <span class="wsub block mb-3">Digital Assets</span>
                  </div>
                )}

                {c.photo && (
                  <div style="margin-top:-0.9rem">
                    <div class="relative overflow-hidden rounded-xl" style="aspect-ratio:16/10">
                      <img src={c.photo.src} alt={c.photo.caption} class="w-full h-full object-cover" />
                      <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(8,15,22,0.85) 0%, transparent 55%)"></div>
                      <p class="absolute bottom-0 left-0 right-0 px-3 pb-2.5 text-white" style="font-family:var(--font-display);font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase">{c.photo.caption}</p>
                    </div>
                  </div>
                )}

                {c.videos && (
                  <div style="margin-top:-0.9rem">
                    <div class="grid grid-cols-2 gap-2">
                      {c.videos.map(v => (
                        <a href={`https://vimeo.com/${v.vid}`} target="_blank" rel="noopener" class="group relative block rounded-lg overflow-hidden bg-navy-800 aspect-video">
                          <img src={`https://vumbnail.com/${v.vid}.jpg`} alt={v.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors"></div>
                          <div class="absolute inset-0 flex items-center justify-center">
                            <span class="w-7 h-7 rounded-full bg-white/90 flex items-center justify-center">
                              <svg class="w-2.5 h-2.5 text-navy-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            </span>
                          </div>
                          <p class="absolute bottom-0 left-0 right-0 px-1.5 pb-1 text-white text-[0.6rem] font-semibold leading-tight" style="font-family:var(--font-display);text-shadow:0 1px 3px rgba(0,0,0,0.8)">{v.title}</p>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {c.phones && (
                  <div style="margin-top:-0.9rem">
                    <div class="flex flex-col items-center gap-4">
                      {/* one handset, the course inside it switches */}
                      <div class="relative" style="width:212px">
                        <span style="position:absolute;left:-2.5px;top:100px;width:3px;height:22px;background:linear-gradient(90deg,#4a5f78,#2a3a4d);border-radius:2px 0 0 2px"></span>
                        <span style="position:absolute;left:-2.5px;top:136px;width:3px;height:40px;background:linear-gradient(90deg,#4a5f78,#2a3a4d);border-radius:2px 0 0 2px"></span>
                        <span style="position:absolute;left:-2.5px;top:188px;width:3px;height:40px;background:linear-gradient(90deg,#4a5f78,#2a3a4d);border-radius:2px 0 0 2px"></span>
                        <span style="position:absolute;right:-2.5px;top:160px;width:3px;height:58px;background:linear-gradient(270deg,#4a5f78,#2a3a4d);border-radius:0 2px 2px 0"></span>

                        {/* titanium frame */}
                        <div class="relative" style="aspect-ratio:9/19.5;border-radius:2.5rem;padding:3.5px;background:linear-gradient(145deg,#8fa3ba 0%,#3d4f64 12%,#1a2531 42%,#141d27 70%,#6b8299 100%);box-shadow:0 26px 60px rgba(13,27,42,0.45), 0 4px 10px rgba(13,27,42,0.4)">
                          <div style="position:absolute;inset:3.5px;border-radius:2.35rem;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.16);pointer-events:none;z-index:50"></div>

                          <div class="relative w-full h-full overflow-hidden" style="border-radius:2.32rem;background:#0B141A">

                            {/* dynamic island */}
                            <div style="position:absolute;left:50%;transform:translateX(-50%);top:9px;width:66px;height:19px;background:#000;border-radius:999px;z-index:45"></div>

                            {/* status bar */}
                            <div style="position:absolute;inset-inline:0;top:0;height:30px;z-index:44;display:flex;align-items:center;justify-content:space-between;padding:9px 15px 0">
                              <span style="color:#fff;font-size:0.52rem;font-weight:700;font-family:var(--font-display);letter-spacing:0.01em">9:41</span>
                              <span style="display:flex;align-items:center;gap:3px">
                                <svg width="11" height="8" viewBox="0 0 18 12" fill="#fff"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1" opacity="0.45"/></svg>
                                <svg width="10" height="8" viewBox="0 0 16 12" fill="#fff"><path d="M8 11.2 5.6 8.6a3.6 3.6 0 0 1 4.8 0L8 11.2Zm0-5.1a6.6 6.6 0 0 0-4.7 1.9L1.6 6.3a9 9 0 0 1 12.8 0l-1.7 1.7A6.6 6.6 0 0 0 8 6.1Z"/></svg>
                                <span style="display:inline-flex;align-items:center;gap:1px">
                                  <span style="width:13px;height:7px;border:1px solid rgba(255,255,255,0.6);border-radius:2px;padding:1px;display:inline-flex"><span style="flex:1;background:#fff;border-radius:1px"></span></span>
                                  <span style="width:1px;height:3px;background:rgba(255,255,255,0.6);border-radius:0 1px 1px 0"></span>
                                </span>
                              </span>
                            </div>

                            {/* chat header */}
                            <div style="position:absolute;inset-inline:0;top:30px;height:44px;z-index:40;display:flex;align-items:center;gap:7px;padding:0 11px;background:rgba(17,27,34,0.98);border-bottom:1px solid rgba(255,255,255,0.06)">
                              <span style="width:25px;height:25px;border-radius:50%;background:linear-gradient(140deg,#F4621F,#D4521A);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;font-family:var(--font-display);font-size:0.5rem;font-weight:700;color:#fff">AG</span>
                              <div style="min-width:0;flex:1">
                                <p class="phone-title" style="color:#E9EDEF;font-size:0.58rem;font-weight:600;line-height:1.15;font-family:var(--font-display);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Course</p>
                                <p style="color:#8696A0;font-size:0.47rem;line-height:1.2;font-family:var(--font-display)">online</p>
                              </div>
                            </div>

                            <div style="position:absolute;inset:0;background:#0B141A;background-image:radial-gradient(rgba(255,255,255,0.022) 1px, transparent 1px);background-size:13px 13px"></div>

                            {c.phones.map((p, i) => (
                              <div class={`phone-screen absolute inset-0 ${i === 0 ? '' : 'hidden'}`} data-screen={i} data-name={p.name} data-vid={p.vid}>
                                <div style="position:absolute;inset-inline:0;top:74px;bottom:0;padding:11px 9px;display:flex;flex-direction:column;gap:7px">
                                  <div style="align-self:flex-start;max-width:88%;background:#202C33;border-radius:8px 8px 8px 2px;padding:6px 8px 4px">
                                    <p style="color:#E9EDEF;font-size:0.56rem;line-height:1.35;font-family:var(--font-body)">{p.name}</p>
                                    <p style="color:#8696A0;font-size:0.42rem;text-align:right;margin-top:1px;font-family:var(--font-body)">09:41</p>
                                  </div>

                                  <button type="button" class="phone-play group" data-vid={p.vid} style="align-self:flex-start;max-width:92%;background:#202C33;border-radius:8px;padding:4px;border:none;cursor:pointer;text-align:left">
                                    <span style="position:relative;display:block;border-radius:6px;overflow:hidden;aspect-ratio:16/11">
                                      <img src={`https://vumbnail.com/${p.vid}.jpg`} alt={p.name} style="width:100%;height:100%;object-fit:cover" />
                                      <span style="position:absolute;inset:0;background:rgba(8,15,22,0.3)"></span>
                                      <span class="transition-transform group-hover:scale-110" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,0.95);display:flex;align-items:center;justify-content:center">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="#0B141A" style="margin-left:2px"><path d="M8 5v14l11-7z"/></svg>
                                      </span>
                                    </span>
                                    <span style="display:flex;align-items:center;justify-content:space-between;padding:4px 3px 1px">
                                      <span style="display:inline-block;font-size:0.42rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:1px 5px;border-radius:999px;background:rgba(244,98,31,0.9);color:#fff;font-family:var(--font-display)">{p.tag}</span>
                                      <span style="color:#8696A0;font-size:0.42rem;font-family:var(--font-body)">09:41</span>
                                    </span>
                                  </button>

                                  <div style="align-self:flex-end;max-width:70%;background:#005C4B;border-radius:8px 8px 2px 8px;padding:6px 8px 4px">
                                    <p style="color:#E9EDEF;font-size:0.56rem;line-height:1.35;font-family:var(--font-body)">Ready when you are</p>
                                    <p style="color:rgba(233,237,239,0.55);font-size:0.42rem;text-align:right;margin-top:1px;font-family:var(--font-body)">09:42</p>
                                  </div>
                                </div>
                              </div>
                            ))}

                            {/* in-place player */}
                            <div id="phone-player" class="hidden" style="position:absolute;inset:0;z-index:46;background:#000">
                              <div id="phone-player-slot" style="position:absolute;inset:0"></div>
                              <button type="button" id="phone-close" aria-label="Close video"
                                style="position:absolute;top:36px;right:10px;z-index:48;width:26px;height:26px;border-radius:50%;background:rgba(0,0,0,0.55);border:1px solid rgba(255,255,255,0.25);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                              </button>
                            </div>

                            {/* screen gloss + home indicator */}
                            <div style="position:absolute;inset:0;z-index:47;pointer-events:none;background:linear-gradient(122deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.03) 18%, transparent 38%)"></div>
                            <div style="position:absolute;left:50%;transform:translateX(-50%);bottom:6px;width:80px;height:4px;border-radius:999px;background:rgba(255,255,255,0.75);z-index:48;pointer-events:none"></div>
                          </div>
                        </div>
                      </div>

                      <div class="flex items-center gap-2">
                        {c.phones.map((p, i) => (
                          <button type="button" class="phone-dot rounded-full transition-all" data-dot={i}
                            aria-label={p.name}
                            style={`width:${i === 0 ? '22px' : '8px'};height:8px;background:${i === 0 ? '#F4621F' : '#DDD6CC'};border:none;cursor:pointer;padding:0`}></button>
                        ))}
                      </div>
                      <p class="text-navy-400 text-[0.7rem] text-center" style="font-family:var(--font-display)">Tap a dot to switch course</p>
                    </div>
                  </div>
                )}

                {c.pills && (
                  <div style="margin-top:-0.9rem">
                    <div class="flex flex-wrap gap-1.5">
                      {c.pills.items.map(t => (
                        <a href={t.href} target="_blank" rel="noopener" class="text-xs px-2.5 py-1 rounded-full transition-colors" style="background:#FFF3EE;color:#F4621F;border:1px solid rgba(244,98,31,0.22);font-family:var(--font-display)">{t.name}</a>
                      ))}
                    </div>
                  </div>
                )}

                {c.links && (
                  <div style="margin-top:-0.9rem">
                    <div class="grid sm:grid-cols-2 gap-2 items-stretch">
                      {c.links.map(d => (
                        <a href={d.href} target="_blank" rel="noopener" class="flex items-center justify-between gap-3 px-3.5 rounded-xl border border-warm-200 hover:border-orange-300 transition-colors group" style="min-height:68px">
                          <div class="min-w-0">
                            <p class="text-orange-500 font-bold uppercase" style="font-family:var(--font-display);font-size:0.55rem;letter-spacing:0.06em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{d.tag}</p>
                            <p class="text-navy-800 font-medium mt-0.5" style="font-family:var(--font-display);font-size:0.78rem;line-height:1.28;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">{d.name}</p>
                          </div>
                          <span class="text-orange-500 text-xs font-bold flex-shrink-0 group-hover:translate-x-0.5 transition-transform">→</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {c.note && (
                  <p class="text-[0.7rem] leading-snug px-3 py-2 rounded-lg" style="background:#FFF3EE;color:#D4521A;font-family:var(--font-display)">{c.note}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <script is:inline>
    (function () {
      const btns = { classroom: document.getElementById('tg-classroom'), field: document.getElementById('tg-field') };
      const on  = 'background:#0D1B2A;color:#fff;border:1px solid #0D1B2A;cursor:pointer;font-family:var(--font-display)';
      const off = 'background:#F4F1EC;color:#5B7494;border:1px solid #EDE8DF;cursor:pointer;font-family:var(--font-display)';
      function show(which) {
        document.querySelectorAll('.wgroup').forEach(g => g.classList.toggle('hidden', g.dataset.group !== which));
        Object.entries(btns).forEach(([k, b]) => { if (b) b.style.cssText = (k === which ? on : off); });
      }
      Object.entries(btns).forEach(([k, b]) => b && b.addEventListener('click', () => show(k)));
    })();
    (function () {
      const first = document.querySelector('.phone-screen');
      const title = document.querySelector('.phone-title');
      if (first && title) title.textContent = first.dataset.name;
    })();
    (function () {
      const player = document.getElementById('phone-player');
      const slot   = document.getElementById('phone-player-slot');
      const close  = document.getElementById('phone-close');
      function stop() {
        if (!player) return;
        player.classList.add('hidden');
        if (slot) slot.innerHTML = '';
      }
      document.querySelectorAll('.phone-play').forEach(btn => {
        btn.addEventListener('click', () => {
          if (!player || !slot) return;
          slot.innerHTML = '<iframe src="https://player.vimeo.com/video/' + btn.dataset.vid +
            '?autoplay=1&title=0&byline=0&portrait=0&playsinline=1&dnt=1" ' +
            'style="position:absolute;inset:0;width:100%;height:100%;border:none" ' +
            'allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
          player.classList.remove('hidden');
        });
      });
      if (close) close.addEventListener('click', stop);
      document.querySelectorAll('.phone-dot').forEach(d => d.addEventListener('click', stop));
    })();
    document.querySelectorAll('.phone-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        const n = dot.dataset.dot;
        document.querySelectorAll('.phone-screen').forEach(sc => sc.classList.toggle('hidden', sc.dataset.screen !== n));
        const active = document.querySelector('.phone-screen:not(.hidden)');
        const title = document.querySelector('.phone-title');
        if (active && title) title.textContent = active.dataset.name;
        document.querySelectorAll('.phone-dot').forEach(d => {
          const on = d.dataset.dot === n;
          d.style.width = on ? '22px' : '8px';
          d.style.background = on ? '#F4621F' : '#DDD6CC';
        });
      });
    });
  </script>
</Layout>
