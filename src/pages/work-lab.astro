---
import Layout from '../layouts/Layout.astro';

// PROTOTYPE of a restructured Work section. Not linked from anywhere, noindex.
// One card frame, seven cards, two labelled groups, no tabs.
// Contents deliberately vary between cards; only the frame is constant.

const CLASSROOM = [
  {
    name: "Finance",
    line: "Built on the $1.6B book I managed at Baird, brought straight into the classroom.",
    stats: [["$1.6B","Real-world AUM"],["300+","Sessions delivered"],["6","Courses"]],
    courses: [["Capital Markets","Flagship · 25 Sessions"],["Corporate Finance","15 Sessions"],["Financial Consulting","15 Sessions"],["AI-Powered Finance","15 Sessions"],["Financial Markets & Fintech","15 Sessions"],["Advanced Financial Management","15 Sessions"]],
    links: [
      { tag: "Interactive Hub", name: "Capital Markets Hub · 22 Activities", href: "https://arseniygoldberg.com/capital-markets" },
      { tag: "Course Portfolio", name: "Finance Modules · 50 Video Lessons", href: "https://arseniyportfolio.my.canva.site/arseniy-goldberg-finance-mba-portfolio" },
    ],
    videos: [
      { vid: "1175592384", title: "Time Value of Money" },
      { vid: "1175592202", title: "Working Capital" },
      { vid: "1175592624", title: "Dynamic Valuation" },
      { vid: "1175592738", title: "Sources of Corporate Financing" },
    ],
  },
  {
    name: "Entrepreneurship & AI",
    line: "Five ventures built from scratch across six countries. Founder experience, taught first-hand.",
    stats: [["5","Ventures built"],["5","Innovation programs"],["3","Continents"]],
    courses: [["Entrepreneurial Journey","Flagship · 15 Sessions"],["Design Thinking","8 Sessions"],["Customer Experience","10 Sessions"],["AI as a Cofounder","3 Sessions"],["Business Applications of AI","12 Sessions"],["AI for Productivity","5 Sessions"]],
    videos: [
      { vid: "1175612851", title: "Intro to Entrepreneurship" },
      { vid: "1175612955", title: "Startup Culture" },
      { vid: "1175612878", title: "Lean Startup" },
      { vid: "1175612914", title: "Product Prototyping" },
    ],
  },
  {
    name: "Behavioral Sciences",
    line: "How bias shows up in professional decisions. Applied across finance, leadership, and AI adoption.",
    stats: [["6","Courses"],["3","Live simulations"],["5+","Industries"]],
    courses: [["Critical Skills for the Modern World","Flagship · 15 Sessions"],["Critical Thinking in the AI Era","8 Sessions"],["Decision Making","8 Sessions"],["Financial Behavior","8 Sessions"],["Complex Problem Solving","5 Sessions"],["AI for Professors","Up to 5 Sessions"]],
    links: [
      { tag: "Custom GPT", name: "Telecomm AI Quick Case", href: "https://chatgpt.com/g/g-67583b3565cc819191dadde542a09a5f-telecommunications-ai-quick-case" },
      { tag: "Custom GPT", name: "Telecomm Decision-Making Simulator", href: "https://chatgpt.com/g/g-67581efa33bc8191ad199d44d44cd04f-telecommunications-decision-making-simulator" },
      { tag: "Claude Artifact", name: "The War Room", href: "https://claude.ai/public/artifacts/b3f7ebf5-4457-4860-9436-ecd6483d46d5" },
    ],
  },
];

const FIELD = [
  {
    name: "Innovation Programs",
    line: "Five programs built and run across three continents, from Azerbaijan to Saudi Arabia to Spain.",
    stats: [["5","Programs"],["3","Continents"],["€250k","Pilot funding"]],
    list: { label: "Programs", items: [
      { name: "RCU Scale-up Hub", meta: "Saudi Arabia · 2024", href: "/rcu-scale-up-hub.pdf" },
      { name: "SABAH Hub", meta: "Azerbaijan", href: "https://sabahhub.com/" },
      { name: "Changemakers Program", meta: "Switzerland", href: "https://www.wyssacademy.org/en/changemakers-program" },
      { name: "Science Connexion & Blue Lab", meta: "Mexico", href: "https://scienceconnexion.com/Convocatorias/SobreReto/6" },
      { name: "Santander Innovators 90", meta: "Spain · 2026", href: "https://app.santanderopenacademy.com/en/program/innovation-and-ai-experience-in-madrid" },
    ]},

  },
  {
    name: "AI in Practice",
    line: "GenAI tools built for real professional contexts, from classroom simulations to client intelligence.",
    stats: [["8","Client deliverables"],["2","Custom GPTs"],["4","Walkthroughs"]],
    pills: { label: "Custom GPTs", items: [
      { name: "Futures Trader Pro", href: "https://chatgpt.com/g/g-67f17440919481918ec80d0593f8f218-futures-trader-pro" },
      { name: "Macro Finance World", href: "https://chatgpt.com/g/g-67ab3edec99881918e280a7f42de0e27-macro-finance-world" },
    ]},
    videos: [
      { vid: "1175529346", title: "AI + Excel" },
      { vid: "1175529293", title: "Claude + Excel" },
      { vid: "1175530353", title: "Perplexity + Finance" },
      { vid: "1175532671", title: "NotebookLM" },
    ],
    links: [
      { tag: "Program Experience", name: "Santander Innovation AI Experience", href: "https://flow-ag.notion.site/santander-innovation-ai-experience" },
      { tag: "Web App", name: "Gate Check", href: "https://si90-gate-check.onrender.com/" },
      { tag: "Sales Enablement", name: "Finance Academy Navigator", href: "https://claude.ai/code/artifact/baf9a827-77cd-4045-8950-6fa5e8720d73" },
      { tag: "Perplexity Computer", name: "Taif Market Entry", href: "https://taifmarketentry.pplx.app" },
      { tag: "Perplexity Computer", name: "Hormuz Shock", href: "https://hormuzshock.pplx.app" },
      { tag: "Perplexity Computer", name: "Portfolio Risk Analysis", href: "https://portfolioanalysis.pplx.app" },
      { tag: "Perplexity Computer", name: "Macro Risk Intelligence", href: "https://macrorisks.pplx.app" },
      { tag: "Client Asset Bundle", name: "Delta Dossier", href: "/delta-dossier/" },
    ],
  },
  {
    name: "Digital Courses",
    line: "Three fully-produced courses built for Rebundle's WhatsApp platform, delivered as conversational micro-lessons.",
    stats: [["3","Courses produced"],["100%","Mobile-native"],["1","Platform"]],
    phones: [
      { vid: "1175515603", tag: "AI", name: "Generative AI for Business Professionals" },
      { vid: "1175515477", tag: "Analytics", name: "Digital Analytics for Business Professionals" },
      { vid: "1175515542", tag: "Wellbeing", name: "Mental Health in the Digital Era" },
    ],
  },
];
---

<Layout title="Work section prototype" noindex={true}>
  <style>
    .lab-bar { background:#F4621F; color:#fff; font-family:var(--font-display); font-weight:700;
      font-size:0.72rem; letter-spacing:0.18em; text-transform:uppercase; padding:10px 20px; }
    .wcard { background:#fff; border:1px solid #EDE8DF; border-radius:1rem; padding:1.75rem; display:flex; flex-direction:column; gap:1.4rem; }
    .wcard-field { background:linear-gradient(158deg,#132133 0%,#0D1B2A 55%,#0A1522 100%); border-color:rgba(255,255,255,0.09); }
    .wcard-field .wsub { color:rgba(255,255,255,0.42); }
    .wcard-field .text-navy-900 { color:#fff; }
    .wcard-field .text-navy-800 { color:rgba(255,255,255,0.92); }
    .wcard-field .text-navy-500 { color:rgba(255,255,255,0.62); }
    .wcard-field .text-navy-400 { color:rgba(255,255,255,0.48); }
    .wcard-field .text-navy-300 { color:rgba(255,255,255,0.4); }
    .wcard-field .divide-warm-100 > :not([hidden]) ~ :not([hidden]) { border-color:rgba(255,255,255,0.08); }
    .wcard-field .border-warm-200 { border-color:rgba(255,255,255,0.13); }
    .wcard-field a.border-warm-200:hover { border-color:rgba(244,98,31,0.6); }
    .wlabel { font-family:var(--font-display); font-size:0.68rem; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#F4621F; }
    .wsub   { font-family:var(--font-display); font-size:0.62rem; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:#7D99B8; }
  </style>

  <div class="lab-bar">Prototype · not live · the real page is unchanged</div>

  <section class="py-20" style="background:#F4F1EC">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">

      <div class="mb-4 flex items-center gap-3">
        <div style="width:32px;height:2px;background:#F4621F"></div>
        <span class="wlabel">The Work</span>
      </div>
      <h2 class="font-bold text-navy-900 leading-tight mb-14" style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem)">
        Everything, on one page.
      </h2>

      <div class="flex flex-wrap gap-2 mb-10">
        <button type="button" id="tg-classroom" class="wtoggle px-6 py-3 rounded-xl text-sm font-bold transition-all"
          style="font-family:var(--font-display);background:#0D1B2A;color:#fff;border:1px solid #0D1B2A;cursor:pointer">In the Classroom</button>
        <button type="button" id="tg-field" class="wtoggle px-6 py-3 rounded-xl text-sm font-bold transition-all"
          style="font-family:var(--font-display);background:#F4F1EC;color:#5B7494;border:1px solid #EDE8DF;cursor:pointer">In the Field</button>
      </div>

      {[["In the Classroom", CLASSROOM, "classroom"], ["In the Field", FIELD, "field"]].map(([groupName, cards, tone]) => (
        <div class={`wgroup ${tone === "field" ? "hidden" : ""}`} data-group={tone}>

          <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5 items-stretch">
            {cards.map(c => (
              <div class={`wcard ${tone === "field" ? "wcard-field" : ""}`}>
                {/* identity */}
                <div>
                  <span class="wlabel block mb-2">{c.name}</span>
                  <p class="text-navy-500 text-sm leading-relaxed">{c.line}</p>
                </div>

                {/* numbers */}
                <div class="flex flex-wrap pb-1" style="column-gap:1.9rem;row-gap:0.75rem">
                  {c.stats.map(([n, l]) => (
                    <div class="flex-shrink-0">
                      <p class="font-bold text-navy-900 text-xl leading-none" style="font-family:var(--font-display)">{n}</p>
                      <p class="text-navy-400 text-[0.7rem] mt-1 whitespace-nowrap" style="font-family:var(--font-display)">{l}</p>
                    </div>
                  ))}
                </div>

                {c.courses && (
                  <div>
                    <span class="wsub block mb-3">Courses</span>
                    <div class="flex flex-col divide-y divide-warm-100">
                      {c.courses.map(([n, meta]) => (
                        <div class="flex items-baseline justify-between gap-3 py-2">
                          <span class="text-navy-800 text-sm leading-snug" style="font-family:var(--font-display)">{n}</span>
                          <span class="text-navy-300 text-xs flex-shrink-0" style="font-family:var(--font-display)">{meta}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {c.list && (
                  <div>
                    <span class="wsub block mb-3">{c.list.label}</span>
                    <div class="flex flex-col divide-y divide-warm-100">
                      {c.list.items.map(p => (
                        <a href={p.href} target="_blank" rel="noopener" class="flex items-baseline justify-between gap-3 py-2 group">
                          <span class="text-navy-800 text-sm leading-snug group-hover:text-orange-500 transition-colors" style="font-family:var(--font-display)">{p.name}</span>
                          <span class="text-navy-300 text-xs flex-shrink-0" style="font-family:var(--font-display)">{p.meta}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {c.videos && (
                  <div>
                    <span class="wsub block mb-3">Sessions</span>
                    <div class="grid grid-cols-2 gap-2">
                      {c.videos.map(v => (
                        <a href={`https://vimeo.com/${v.vid}`} target="_blank" rel="noopener" class="group relative block rounded-lg overflow-hidden bg-navy-800 aspect-video">
                          <img src={`https://vumbnail.com/${v.vid}.jpg`} alt={v.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors"></div>
                          <div class="absolute inset-0 flex items-center justify-center">
                            <span class="w-7 h-7 rounded-full bg-white/90 flex items-center justify-center">
                              <svg class="w-2.5 h-2.5 text-navy-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            </span>
                          </div>
                          <p class="absolute bottom-0 left-0 right-0 px-1.5 pb-1 text-white text-[0.6rem] font-semibold leading-tight" style="font-family:var(--font-display);text-shadow:0 1px 3px rgba(0,0,0,0.8)">{v.title}</p>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {c.phones && (
                  <div>
                    <span class="wsub block mb-3">On WhatsApp</span>
                    <div class="flex flex-col items-center gap-4">
                      {/* one handset, the course inside it switches */}
                      <div class="relative" style="width:196px">
                        {/* side buttons */}
                        <span style="position:absolute;left:-3px;top:88px;width:3px;height:26px;background:#1b2b3d;border-radius:2px 0 0 2px"></span>
                        <span style="position:absolute;left:-3px;top:126px;width:3px;height:44px;background:#1b2b3d;border-radius:2px 0 0 2px"></span>
                        <span style="position:absolute;left:-3px;top:182px;width:3px;height:44px;background:#1b2b3d;border-radius:2px 0 0 2px"></span>
                        <span style="position:absolute;right:-3px;top:150px;width:3px;height:62px;background:#1b2b3d;border-radius:0 2px 2px 0"></span>

                        <div class="relative" style="aspect-ratio:9/19.5;border-radius:2.1rem;padding:9px;background:linear-gradient(150deg,#243447 0%,#0f1b28 45%,#1d2c3e 100%);box-shadow:0 18px 44px rgba(13,27,42,0.34), 0 2px 6px rgba(13,27,42,0.3)">
                          <div class="relative w-full h-full overflow-hidden" style="border-radius:1.55rem;background:#0B141A">

                            {/* dynamic island */}
                            <div style="position:absolute;left:50%;transform:translateX(-50%);top:7px;width:56px;height:16px;background:#000;border-radius:999px;z-index:30"></div>

                            {/* whatsapp chat header */}
                            <div style="position:absolute;inset-inline:0;top:0;height:64px;background:#075E54;z-index:20;display:flex;align-items:flex-end;gap:8px;padding:0 10px 8px">
                              <span style="width:26px;height:26px;border-radius:50%;background:#25D366;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.7 14.9L2 22l5.3-1.4A10 10 0 1 0 12 2z"/></svg>
                              </span>
                              <div style="min-width:0">
                                <p class="phone-title" style="color:#fff;font-size:0.6rem;font-weight:700;line-height:1.1;font-family:var(--font-display);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Course</p>
                                <p style="color:rgba(255,255,255,0.65);font-size:0.5rem;line-height:1.2;font-family:var(--font-display)">online</p>
                              </div>
                            </div>

                            {c.phones.map((p, i) => (
                              <div class={`phone-screen absolute inset-0 ${i === 0 ? '' : 'hidden'}`} data-screen={i} data-name={p.name}>
                                <img src={`https://vumbnail.com/${p.vid}.jpg`} alt={p.name} class="w-full h-full object-cover" />
                                <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(8,15,22,0.94) 0%, rgba(8,15,22,0.12) 48%, rgba(7,94,84,0.45) 100%)"></div>
                                <div class="absolute inset-x-0 bottom-0" style="padding:10px 10px 14px">
                                  <span class="inline-block" style="font-size:0.5rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:999px;background:#F4621F;color:#fff;font-family:var(--font-display);margin-bottom:5px">{p.tag}</span>
                                  <p style="color:#fff;font-size:0.7rem;font-weight:600;line-height:1.2;font-family:var(--font-display)">{p.name}</p>
                                </div>
                                <a href={`https://vimeo.com/${p.vid}`} target="_blank" rel="noopener" class="absolute inset-0 flex items-center justify-center group">
                                  <span class="flex items-center justify-center transition-transform group-hover:scale-110" style="width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,0.92);box-shadow:0 4px 14px rgba(0,0,0,0.3)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#0D1B2A" style="margin-left:2px"><path d="M8 5v14l11-7z"/></svg>
                                  </span>
                                </a>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>

                      <div class="flex items-center gap-2">
                        {c.phones.map((p, i) => (
                          <button type="button" class="phone-dot rounded-full transition-all" data-dot={i}
                            aria-label={p.name}
                            style={`width:${i === 0 ? '22px' : '8px'};height:8px;background:${i === 0 ? '#F4621F' : '#DDD6CC'};border:none;cursor:pointer;padding:0`}></button>
                        ))}
                      </div>
                      <p class="text-navy-400 text-[0.7rem] text-center" style="font-family:var(--font-display)">Tap a dot to switch course</p>
                    </div>
                  </div>
                )}

                {c.pills && (
                  <div>
                    <span class="wsub block mb-3">{c.pills.label}</span>
                    <div class="flex flex-wrap gap-1.5">
                      {c.pills.items.map(t => (
                        <a href={t.href} target="_blank" rel="noopener" class="text-xs px-2.5 py-1 rounded-full transition-colors" style="background:#FFF3EE;color:#F4621F;border:1px solid rgba(244,98,31,0.22);font-family:var(--font-display)">{t.name}</a>
                      ))}
                    </div>
                  </div>
                )}

                {c.links && (
                  <div>
                    <span class="wsub block mb-3">Digital Assets</span>
                    <div class="grid sm:grid-cols-2 gap-1.5">
                      {c.links.map(d => (
                        <a href={d.href} target="_blank" rel="noopener" class="flex items-center justify-between gap-3 px-3 py-2 rounded-lg border border-warm-200 hover:border-orange-300 transition-colors group">
                          <div class="min-w-0">
                            <p class="text-[0.62rem] text-orange-500 font-semibold" style="font-family:var(--font-display)">{d.tag}</p>
                            <p class="text-xs text-navy-800 font-medium leading-snug" style="font-family:var(--font-display)">{d.name}</p>
                          </div>
                          <span class="text-orange-500 text-xs font-bold flex-shrink-0 group-hover:translate-x-0.5 transition-transform">→</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {c.note && (
                  <p class="text-[0.7rem] leading-snug px-3 py-2 rounded-lg" style="background:#FFF3EE;color:#D4521A;font-family:var(--font-display)">{c.note}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <script is:inline>
    (function () {
      const btns = { classroom: document.getElementById('tg-classroom'), field: document.getElementById('tg-field') };
      const on  = 'background:#0D1B2A;color:#fff;border:1px solid #0D1B2A;cursor:pointer;font-family:var(--font-display)';
      const off = 'background:#F4F1EC;color:#5B7494;border:1px solid #EDE8DF;cursor:pointer;font-family:var(--font-display)';
      function show(which) {
        document.querySelectorAll('.wgroup').forEach(g => g.classList.toggle('hidden', g.dataset.group !== which));
        Object.entries(btns).forEach(([k, b]) => { if (b) b.style.cssText = (k === which ? on : off); });
      }
      Object.entries(btns).forEach(([k, b]) => b && b.addEventListener('click', () => show(k)));
    })();
    (function () {
      const first = document.querySelector('.phone-screen');
      const title = document.querySelector('.phone-title');
      if (first && title) title.textContent = first.dataset.name;
    })();
    document.querySelectorAll('.phone-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        const n = dot.dataset.dot;
        document.querySelectorAll('.phone-screen').forEach(sc => sc.classList.toggle('hidden', sc.dataset.screen !== n));
        const active = document.querySelector('.phone-screen:not(.hidden)');
        const title = document.querySelector('.phone-title');
        if (active && title) title.textContent = active.dataset.name;
        document.querySelectorAll('.phone-dot').forEach(d => {
          const on = d.dataset.dot === n;
          d.style.width = on ? '22px' : '8px';
          d.style.background = on ? '#F4621F' : '#DDD6CC';
        });
      });
    });
  </script>
</Layout>
