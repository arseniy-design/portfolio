---
// Services, rebuilt 2026-09-23 from the approved prototype (~/site-unify-prototype/site.html).
// A question at the top splits visitors: team or company (shown by default) vs just me.
// Only the chosen side shows. Deep links: /services#organization and /services#individual.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import '../styles/site.css';
import { ART, ICONS, STEPS, ORG, IND, px } from '../data/site';

const FORM = 'https://formspree.io/f/mgonnqob';

const LOGOS = [
  ['ie-university.png', 'IE University'], ['santander.png', 'Santander'], ['pif-mono.png', 'PIF'], ['nissan.png', 'Nissan'],
  ['stc.png', 'stc'], ['kyowa-kirin.png', 'Kyowa Kirin'], ['ministry-of-finance.png', 'Saudi Ministry of Finance'], ['zatca.png', 'ZATCA'],
  ['flir.png', 'FLIR'], ['texas-medical-center.png', 'Texas Medical Center'], ['elm.png', 'Elm'], ['virginia-tech.png', 'Virginia Tech'],
  ['oregon-state.png', 'Oregon State University'], ['tec-de-monterrey.webp', 'Tec de Monterrey'], ['wyss-academy.png', 'Wyss Academy'],
];
---
<Layout
  title="Services · Arseniy Goldberg"
  description="AI that moves the number. Implementing and measuring AI for finance and tech teams, building products and programs, speaking. One to one work on AI, career, personal brand and money."
>
  <div class="site">
    <Nav current="services" tone="light" cta="#talk" />

    <section class="wrap gate" id="top">
      <div class="who"><img src="/hero-figure.webp" alt="" />Arseniy Goldberg · Founding Partner, Flow · Academic Director, IE Business School</div>
      <h1>AI that moves<br />the number.</h1>
      <p class="lede" style="text-align:center">I help teams put AI to work and prove what it is worth. And I help people use it for their own work and money.</p>
      <p class="ask" style="margin-top:14px">Who are you looking for help for?</p>
      <div class="doors">
        <div class="door"><button type="button" class="btn" id="pick-org" data-pick="organization" aria-pressed="true">My team or company</button><small>Implement AI · Measure AI · Build · Speak</small></div>
        <div class="door"><button type="button" class="btn ghost" id="pick-ind" data-pick="individual" aria-pressed="false">Just me</button><small>1:1 AI · Career · Personal brand · Money</small></div>
      </div>
    </section>

    <section class="logoband" aria-label="Organizations I have worked with">
      <p class="label" style="text-align:center;color:var(--mute)">Worked with</p>
      <div class="marquee"><div class="mq-track">
        {LOGOS.map(([f, n]) => <img src={`/logos/${f}`} alt={n} />)}
        {LOGOS.map(([f, n]) => <img src={`/logos/${f}`} alt="" aria-hidden="true" />)}
      </div></div>
    </section>

    <div id="organization" data-side="organization">
      <section class="wrap sec">
        <div class="sec-head"><span class="label">For your team or company</span><h2 style="margin-top:14px">Work with me<br /><span>on the problem you have.</span></h2></div>
        <div class="tiles three">
          {ORG.map((o: any) => (
            <button type="button" class="tile" data-open={`org:${o.k}`}>
              <div class="ph art"><Fragment set:html={ART[o.k]} /><span class="tag" set:html={o.tag} /></div>
              <span class="who2">{o.who}</span>
              <div class="tt"><h3>{o.t}</h3></div>
              <span class="more" style="justify-self:start">Work with me on this</span>
            </button>
          ))}
        </div>
        <p class="switch">Here for yourself? <a data-pick-link="individual">See one to one work</a></p>
      </section>

      <section class="wrap sec">
        <div class="sec-head"><span class="label">How we work together</span><h2 style="margin-top:14px">People first.<br /><span>The build comes fifth.</span></h2></div>
        <ol class="steps">
          {STEPS.map(([n, l], i) => (
            <li class={i === 4 ? 'key' : ''}><button type="button" aria-label={`${n}: ${l}`}><span class="nm">{n}</span><Fragment set:html={px(ICONS[i], 12, 10)} /></button><span class="tip">{l}</span></li>
          ))}
        </ol>
        <p class="steps-note">Hover or tap a step to read it.</p>
      </section>

      <section class="band">
        <div class="wrap">
          <blockquote>He was an indispensable source of information as well as a connector. He's smart, organized, competent, a proactive problem solver.</blockquote>
          <p class="cite"><b>Mike Grandinetti</b> · Faculty at MIT, Harvard and Hult · ex-McKinsey</p>
        </div>
      </section>
    </div>

    <div id="individual" data-side="individual" hidden>
      <section class="wrap sec">
        <div class="sec-head"><span class="label">For you</span><h2 style="margin-top:14px">Work with me<br /><span>one to one.</span></h2></div>
        <div class="tiles three">
          {IND.map((o: any) => (
            <button type="button" class="tile" data-open={`ind:${o.k}`}>
              <div class="ph art"><Fragment set:html={ART[o.art]} /></div>
              <span class="who2">{o.who}</span>
              <div class="tt"><h3 set:html={o.tt || o.t} /></div>
              <span class="more" style="justify-self:start">Work with me on this</span>
            </button>
          ))}
        </div>
        <p class="switch">Here for your team? <a data-pick-link="organization">See work for organizations</a></p>
      </section>
    </div>

    <section class="wrap sec" id="talk">
      <div class="talk">
        <div class="sec-head" style="margin:0"><h2>Two sentences<br /><span>is enough.</span></h2></div>
        <form id="sv-form">
          <div id="sv-echo" class="echo" hidden><span>You picked</span> <strong id="sv-echo-text"></strong></div>
          <input type="hidden" name="engagement" id="sv-engage" value="Not specified" />
          <input type="hidden" name="side" id="sv-side" value="organization" />
          <input type="hidden" name="_subject" value="Services page enquiry" />
          <div class="pair">
            <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" required /></div>
            <div class="field"><label for="f-email">Work email</label><input id="f-email" name="email" type="email" required /></div>
          </div>
          <div class="pair org-only">
            <div class="field"><label for="f-co">Company</label><input id="f-co" name="company" /></div>
            <div class="field"><label for="f-size">Team size</label><select id="f-size" name="team_size"><option>2 to 10</option><option>11 to 50</option><option>51 to 200</option><option>More than 200</option></select></div>
          </div>
          <div class="pair">
            <div class="field"><label for="f-start">When do you want to start?</label><select id="f-start" name="start"><option>This month</option><option>In 1 to 3 months</option><option>Later this year</option><option>Not sure yet</option></select></div>
            <div class="field"><label for="f-times">Two times that suit you, with your time zone</label><input id="f-times" name="times" /></div>
          </div>
          <div class="field"><label for="f-msg">What is going on, in one sentence</label><input id="f-msg" name="message" /></div>
          <button class="btn" type="submit" id="sv-submit">Send</button>
          <p class="done" id="sv-done" hidden>Got it. I'll be in touch soon.</p>
        </form>
      </div>
    </section>

    <footer class="foot"><div class="wrap"><span>© 2026 Arseniy Goldberg</span><span><a href="/">Home</a><a href="/writing">Writing</a><a href="https://www.linkedin.com/in/arseniygoldberg/" target="_blank" rel="noopener">LinkedIn</a></span></div></footer>
  </div>

  <div class="scrim" id="scrim" hidden></div>
</Layout>

<script define:vars={{ ORG, IND, ART, FORM }}>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  // The two doors: the chosen one turns red, the other grey; only its side shows.
  function pick(side, scroll) {
    document.querySelectorAll('[data-side]').forEach((el) => { el.hidden = el.dataset.side !== side; });
    document.querySelectorAll('[data-pick]').forEach((b) => { const on = b.dataset.pick === side; b.setAttribute('aria-pressed', String(on)); b.classList.toggle('ghost', !on); });
    document.body.classList.toggle('ind', side === 'individual');
    $('sv-side').value = side;
    if (scroll) $(side).scrollIntoView({ behavior: 'smooth' });
  }
  document.querySelectorAll('[data-pick]').forEach((b) => b.addEventListener('click', () => { history.replaceState(null, '', '#' + b.dataset.pick); pick(b.dataset.pick, true); }));
  document.querySelectorAll('[data-pick-link]').forEach((a) => a.addEventListener('click', () => { history.replaceState(null, '', '#' + a.dataset.pickLink); pick(a.dataset.pickLink, true); }));
  const fromHash = () => { const h = location.hash.slice(1); if (h === 'organization' || h === 'individual') pick(h, true); };
  fromHash();
  addEventListener('hashchange', fromHash);

  // Tiles open a sheet with the detail; "Start here" fills the form.
  const scrim = $('scrim');
  function open(id) {
    const [g, k] = id.split(':');
    const o = (g === 'org' ? ORG : IND).find((x) => x.k === k);
    const tl = o.tl ? `<div class="tl"><span class="label">${esc(o.plan)}</span><ol>${o.tl.map(([w, t]) => `<li><b>${esc(w)}</b><span>${esc(t)}</span></li>`).join('')}</ol></div>` : '';
    scrim.innerHTML = `<div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(o.t)}"><div class="ph art">${ART[o.art || o.k]}</div><div class="in"><span class="label">${esc(o.who)}</span><h3>${esc(o.t)}</h3><p>${esc(o.line)}</p><p class="proof">${esc(o.proof)}</p>${tl}<div class="row"><a class="btn" href="#talk" id="sheet-go">Start here</a><button type="button" class="x" id="sheet-x">Close</button></div></div></div>`;
    scrim.hidden = false;
    $('sheet-go').addEventListener('click', () => { $('sv-engage').value = o.t; $('sv-echo-text').textContent = o.t; $('sv-echo').hidden = false; scrim.hidden = true; });
    $('sheet-go').focus();
  }
  document.querySelectorAll('[data-open]').forEach((t) => t.addEventListener('click', () => open(t.dataset.open)));
  scrim.addEventListener('click', (e) => { if (e.target === scrim || e.target.id === 'sheet-x') scrim.hidden = true; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') scrim.hidden = true; });

  // Steps: tap to show the line on touch screens.
  document.querySelectorAll('.steps li').forEach((li) => li.addEventListener('click', () => {
    document.querySelectorAll('.steps li').forEach((l) => l.classList.toggle('open', l === li && !l.classList.contains('open')));
  }));

  // Form: Formspree, stays on the page.
  const form = $('sv-form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('sv-submit'); btn.textContent = 'Sending...'; btn.disabled = true;
    try {
      const res = await fetch(FORM, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      if (!res.ok) throw new Error();
      form.querySelectorAll('.field, .pair, button, .echo').forEach((el) => (el.style.display = 'none'));
      $('sv-done').hidden = false;
    } catch { btn.textContent = 'Send'; btn.disabled = false; }
  });
</script>

<style is:global>
  body { background: #fff; }
  .echo { font-size: 14px; color: var(--mute); padding: 12px 16px; background: var(--soft); border-radius: 12px; }
  .echo strong { color: var(--ink); }
  .switch a { cursor: pointer; }
</style>
