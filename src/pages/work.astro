---
import Layout from '../layouts/Layout.astro';
import WRITING from '../data/writing.json';

export const prerender = true;

// One page to send to a stranger. A dark gallery: every project is a tile
// with its own screenshot and its name. Nothing else. One scroll.
// Two tiles are live: the WhatsApp chat plays its videos in place, and the
// teaching tile pops out the full course list.

const ext = { target: '_blank', rel: 'noopener' };

const MAIN = [
  { name: 'Finance Lessons',          meta: 'AI tutor · 42 filmed lessons',        shot: '/shots/lessons.webp',         href: '/lessons' },
  { name: 'Capital Markets Hub',      meta: 'Live tool · 22 activities',           shot: '/shots/capital-markets.webp', href: '/capital-markets' },
  { name: 'AI-Powered Finance',       meta: 'IE Business School · Academic Director', shot: '/shots/ie-ai-finance.webp', href: 'https://www.ie.edu/lifelong-learning/programs/ai-powered-finance/', ext: true },
  { name: 'Finance Academy Navigator', meta: 'Client prototype · sample data',      shot: '/shots/navigator.webp',       href: 'https://claude.ai/code/artifact/baf9a827-77cd-4045-8950-6fa5e8720d73', ext: true },
  { name: 'Gate Check',               meta: 'Web app · Santander',                 shot: '/shots/gatecheck.webp',       href: 'https://si90-gate-check.onrender.com/', ext: true },
  { name: 'The War Room',             meta: 'Simulation · English and Arabic',     shot: '/shots/warroom.webp',         href: 'https://claude.ai/public/artifacts/b3f7ebf5-4457-4860-9436-ecd6483d46d5', ext: true },
  { name: 'Writing',                  meta: `${WRITING.length} pieces · since 2020`, shot: '/shots/writing.webp',      href: '/writing' },
];

// The three WhatsApp courses. Same three as the homepage phone.
const CHAT = [
  { vid: '1175515603', tag: 'AI',        name: 'Generative AI for Business Professionals' },
  { vid: '1175515477', tag: 'Analytics', name: 'Digital Analytics for Business Professionals' },
  { vid: '1175515542', tag: 'Wellbeing', name: 'Mental Health in the Digital Era' },
];

// The teaching stack, copied from the homepage's last work card.
const TEACHING = [
  { name: 'Finance', line: 'Built on the $1.6B book I managed at Baird, brought straight into the classroom.',
    courses: [['Capital Markets','25 sessions'],['Corporate Finance','15 sessions'],['Financial Consulting','15 sessions'],['AI-Powered Finance','15 sessions'],['Financial Markets & Fintech','15 sessions'],['Advanced Financial Management','15 sessions']] },
  { name: 'Entrepreneurship & AI', line: 'Five ventures built from scratch across six countries. Founder experience, taught first-hand.',
    courses: [['Entrepreneurial Journey','15 sessions'],['Design Thinking','8 sessions'],['Customer Experience','10 sessions'],['AI as a Cofounder','3 sessions'],['Business Applications of AI','12 sessions'],['AI for Productivity','5 sessions']] },
  { name: 'Behavioral Sciences', line: 'How bias shows up in professional decisions. Applied across finance, leadership, and AI adoption.',
    courses: [['Critical Skills for the Modern World','15 sessions'],['Critical Thinking in the AI Era','8 sessions'],['Decision Making','8 sessions'],['Financial Behavior','8 sessions'],['Complex Problem Solving','5 sessions'],['AI for Professors','Up to 5 sessions']] },
];
const courseCount = TEACHING.reduce((n, t) => n + t.courses.length, 0);

const BRIEFS = [
  { name: 'Delta Dossier',     meta: 'Pre-earnings deep dive', shot: '/shots/t-delta.webp',         href: '/delta-dossier/' },
  { name: 'Portfolio Risk',    meta: 'Scenario testing',       shot: '/shots/t-portfoliorisk.webp', href: '/portfolio-risk/' },
  { name: 'Macro Risks',       meta: 'Five risks, one page',   shot: '/shots/t-macro.webp',         href: '/macro-risks/' },
  { name: 'Hormuz Shock',      meta: 'Commodity markets',      shot: '/shots/t-hormuz.webp',        href: '/hormuz-shock/' },
  { name: 'Taif Market Entry', meta: 'Wellness tourism',       shot: '/shots/t-taif.webp',          href: '/taif-market-entry/' },
];

const PROGRAMS = [
  { name: 'RCU Scale-up Hub',             meta: 'Saudi Arabia · 2024', shot: '/shots/p-rcu.webp', pos: 'top left', href: '/rcu-scale-up-hub.pdf', ext: true },
  { name: 'SABAH Hub',                    meta: 'Azerbaijan',          shot: '/shots/p-sabah.webp',           href: 'https://sabahhub.com/', ext: true },
  { name: 'Changemakers Program',         meta: 'Switzerland',         shot: '/shots/p-changemakers.webp',    href: 'https://www.wyssacademy.org/en/changemakers-program', ext: true },
  { name: 'Science Connexion & Blue Lab', meta: 'Mexico',              shot: '/shots/p-scienceconnexion.webp', href: 'https://scienceconnexion.com/Convocatorias/SobreReto/6', ext: true },
  { name: 'Santander Innovators 90',      meta: 'Spain · 2026',        shot: '/shots/p-santander.webp',       href: 'https://app.santanderopenacademy.com/en/program/innovation-and-ai-experience-in-madrid', ext: true },
];

const total = MAIN.length + 2 + BRIEFS.length + PROGRAMS.length;
---

<Layout
  title="Work · Arseniy Goldberg"
  description="Everything Arseniy Goldberg built or runs, on one page: a finance tutor, a live capital markets hub, the AI-Powered Finance program at IE, prototypes, courses, programs, writing."
  ogImage="/shots/capital-markets.webp"
>
  <div class="page">
    <header class="top">
      <a class="brand" href="/">Arseniy Goldberg</a>
      <h1>{total} things I built.<br /><em>Click any of them.</em></h1>
      <p>Finance professor at IE Business School, formerly at Baird. Every tile opens something real.</p>
    </header>

    <main>
      <ul class="grid main">
        {MAIN.slice(0, 6).map(t => (
          <li><a href={t.href} {...(t.ext ? ext : {})}>
            <img src={t.shot} alt={t.name} loading="lazy" />
            <span class="cap"><span class="name">{t.name}</span><span class="meta">{t.meta}</span></span>
          </a></li>
        ))}

        <!-- WhatsApp courses: the tile is the phone screen, videos play in place -->
        <li class="chat-tile" id="chat">
          <div class="chat-head">
            <span class="chat-avatar">AG</span>
            <span class="chat-who"><span class="name">Courses in a chat</span><span class="meta">Three WhatsApp courses · Rebundle</span></span>
          </div>
          <div class="chat-body">
            {CHAT.map(c => (
              <button type="button" class="bubble" data-vid={c.vid} aria-label={`Play ${c.name}`}>
                <span class="thumb">
                  <img src={`https://vumbnail.com/${c.vid}.jpg`} alt="" loading="lazy" />
                  <span class="play"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
                </span>
                <span class="bubble-row"><span class="pill">{c.tag}</span><span class="bubble-name">{c.name}</span></span>
              </button>
            ))}
          </div>
          <div class="chat-player" hidden>
            <div class="chat-slot"></div>
            <button type="button" class="chat-close" aria-label="Close video">×</button>
          </div>
        </li>

        <li><a href={MAIN[6].href}>
          <img src={MAIN[6].shot} alt={MAIN[6].name} loading="lazy" />
          <span class="cap"><span class="name">{MAIN[6].name}</span><span class="meta">{MAIN[6].meta}</span></span>
        </a></li>

        <!-- Teaching: opens the course list -->
        <li><button type="button" class="tile-btn" id="teach-open">
          <img src="/lecture-hall.jpg" alt="Arseniy Goldberg lecturing" loading="lazy" style="object-position:center 40%" />
          <span class="cap"><span class="name">The Teaching Stack</span><span class="meta">{courseCount} courses · 3 domains · 300+ sessions</span></span>
        </button></li>
      </ul>

      <h2>Market briefs</h2>
      <ul class="grid small">
        {BRIEFS.map(t => (
          <li><a href={t.href}>
            <img src={t.shot} alt={t.name} loading="lazy" />
            <span class="cap"><span class="name">{t.name}</span><span class="meta">{t.meta}</span></span>
          </a></li>
        ))}
      </ul>

      <h2>Innovation programs</h2>
      <ul class="grid small">
        {PROGRAMS.map(t => (
          <li><a href={t.href} {...(t.ext ? ext : {})}>
            <img src={t.shot} alt={t.name} loading="lazy" style={t.pos ? `object-position:${t.pos}` : undefined} />
            <span class="cap"><span class="name">{t.name}</span><span class="meta">{t.meta}</span></span>
          </a></li>
        ))}
      </ul>
    </main>

    <footer class="foot">
      <a href="mailto:arseniygoldberg1@gmail.com">arseniygoldberg1@gmail.com</a>
      <a href="https://www.linkedin.com/in/arseniygoldberg/" {...ext}>LinkedIn</a>
      <a href="/">arseniygoldberg.com</a>
    </footer>

    <dialog id="teach" aria-labelledby="teach-title">
      <div class="dlg-head">
        <div>
          <span class="brand">{courseCount} courses · 3 domains · 300+ sessions</span>
          <h3 id="teach-title">The Teaching Stack</h3>
        </div>
        <button type="button" class="dlg-close" id="teach-close" aria-label="Close">×</button>
      </div>
      <div class="domains">
        {TEACHING.map(t => (
          <section>
            <h4>{t.name}</h4>
            <p>{t.line}</p>
            <ul>
              {t.courses.map(([n, meta]) => (
                <li><span>{n}</span><span class="sess">{meta}</span></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </dialog>
  </div>
</Layout>

<script>
  // Chat tile: play a Vimeo video inside the tile, close returns to the chat.
  const chat = document.getElementById('chat');
  if (chat) {
    const player = chat.querySelector('.chat-player') as HTMLElement;
    const slot = chat.querySelector('.chat-slot') as HTMLElement;
    chat.querySelectorAll<HTMLButtonElement>('.bubble').forEach(b => b.addEventListener('click', () => {
      slot.innerHTML = `<iframe src="https://player.vimeo.com/video/${b.dataset.vid}?autoplay=1&title=0&byline=0&portrait=0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
      player.hidden = false;
    }));
    chat.querySelector('.chat-close')?.addEventListener('click', () => { slot.innerHTML = ''; player.hidden = true; });
  }

  // Teaching tile: native dialog, Esc and backdrop click both close it.
  const dlg = document.getElementById('teach') as HTMLDialogElement | null;
  if (dlg) {
    document.getElementById('teach-open')?.addEventListener('click', () => dlg.showModal());
    document.getElementById('teach-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style>
  :global(body) { background: #080F16; }
  .page { min-height: 100vh; background: #080F16; color: #fff; padding: 0 1rem 3rem; }
  .top, main, .foot { max-width: 76rem; margin: 0 auto; }

  .top { text-align: center; padding: 3rem 0 2.75rem; }
  .brand { font-family: var(--font-display); font-weight: 500; font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.5); text-decoration: none; }
  a.brand:hover { color: #fff; }
  .top h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.05; letter-spacing: -.01em; margin: 1.5rem 0 .9rem; }
  .top h1 em { font-style: normal; color: var(--color-orange-500); }
  .top p { color: rgba(255,255,255,.55); font-size: 1rem; }

  h2 { font-family: var(--font-display); font-weight: 500; font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.45); margin: 3rem 0 1rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .grid.main  { grid-template-columns: repeat(2, 1fr); }
  .grid.small { grid-template-columns: repeat(2, 1fr); gap: .75rem; }
  @media (min-width: 640px) {
    .grid.main  { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .grid.small { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  @media (min-width: 960px) {
    .grid.small { grid-template-columns: repeat(5, 1fr); }
  }

  .grid a, .tile-btn, .chat-tile { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; background: #162236; box-shadow: 0 0 0 1px rgba(255,255,255,.06); text-decoration: none; color: #fff; border: 0; padding: 0; margin: 0; font: inherit; text-align: left; cursor: pointer; }
  .grid img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .grid a::after, .tile-btn::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,15,22,.92) 0%, rgba(8,15,22,.45) 38%, rgba(8,15,22,0) 65%); transition: opacity .4s; }
  .grid a:hover img, .tile-btn:hover img { transform: scale(1.04); }
  .grid a:hover::after, .tile-btn:hover::after { opacity: .85; }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: .15rem; }
  .grid.small .cap { padding: .75rem .85rem; }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.15; }
  .grid.small .name { font-size: .95rem; }
  .meta { font-size: .8rem; color: rgba(255,255,255,.65); }
  .grid.small .meta { font-size: .72rem; }
  @media (max-width: 639px) { .name { font-size: 1rem; } .meta { font-size: .72rem; } .cap { padding: .75rem .85rem; } }

  /* chat tile */
  .chat-tile { background: #0B141A; cursor: default; display: flex; flex-direction: column; }
  @media (max-width: 639px) { .chat-tile { grid-column: 1 / -1; aspect-ratio: auto; } .chat-body { overflow: visible; } }
  .chat-head { display: flex; align-items: center; gap: .6rem; padding: .65rem .9rem; background: #111B22; border-bottom: 1px solid rgba(255,255,255,.08); flex-shrink: 0; }
  .chat-avatar { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(140deg, #F4621F, #D4521A); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: .7rem; flex-shrink: 0; }
  .chat-who { display: flex; flex-direction: column; min-width: 0; }
  .chat-who .name { font-size: 1rem; }
  .chat-who .meta { font-size: .72rem; }
  .chat-body { flex: 1; min-height: 0; padding: .6rem .7rem; display: flex; flex-direction: column; gap: .45rem; background: #0B141A; background-image: radial-gradient(rgba(255,255,255,.025) 1px, transparent 1px); background-size: 12px 12px; overflow: hidden; }
  .bubble { display: grid; grid-template-columns: 4.2rem 1fr; gap: .5rem; align-items: center; align-self: flex-start; width: 92%; background: #202C33; border: 0; border-radius: 10px 10px 10px 3px; padding: .35rem; color: #E9EDEF; font: inherit; text-align: left; cursor: pointer; transition: background .2s; }
  .bubble:hover { background: #2A3942; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 11; border-radius: 6px; overflow: hidden; }
  .thumb img { position: static; width: 100%; height: 100%; object-fit: cover; transition: none; }
  .thumb .play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; border-radius: 50%; background: rgba(255,255,255,.95); color: #0B141A; display: flex; align-items: center; justify-content: center; padding-left: 2px; }
  .bubble-row { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .pill { align-self: flex-start; font-family: var(--font-display); font-size: .58rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 1px 6px; border-radius: 999px; background: rgba(244,98,31,.9); color: #fff; }
  .bubble-name { font-size: .78rem; line-height: 1.25; }
  .chat-player { position: absolute; inset: 0; z-index: 3; background: #000; }
  .chat-player[hidden] { display: none; }
  .chat-slot, .chat-slot :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .chat-close { position: absolute; top: .5rem; right: .5rem; z-index: 4; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,.6); border: 1px solid rgba(255,255,255,.3); color: #fff; font-size: 1.1rem; line-height: 1; cursor: pointer; }

  /* teaching dialog */
  dialog { margin: auto; width: min(64rem, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); border: 1px solid rgba(255,255,255,.1); border-radius: 14px; background: #0D1B2A; color: #fff; padding: 0; overflow: auto; }
  dialog::backdrop { background: rgba(8,15,22,.85); }
  .dlg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.75rem 2rem 0; }
  .dlg-head h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.9rem; line-height: 1.1; margin: .5rem 0 0; }
  .dlg-close { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); color: #fff; font-size: 1.3rem; line-height: 1; cursor: pointer; flex-shrink: 0; }
  .dlg-close:hover { background: rgba(255,255,255,.16); }
  .domains { display: grid; gap: 2rem; padding: 1.5rem 2rem 2rem; }
  @media (min-width: 800px) { .domains { grid-template-columns: repeat(3, 1fr); } }
  .domains h4 { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--color-orange-400); margin: 0 0 .4rem; }
  .domains p { font-size: .88rem; line-height: 1.5; color: rgba(255,255,255,.6); margin: 0 0 1rem; }
  .domains ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.1); }
  .domains li { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; padding: .6rem 0; border-bottom: 1px solid rgba(255,255,255,.1); font-family: var(--font-display); font-weight: 500; font-size: .95rem; }
  .sess { font-size: .72rem; color: rgba(255,255,255,.45); white-space: nowrap; }
  @media (max-width: 639px) { .dlg-head, .domains { padding-left: 1.25rem; padding-right: 1.25rem; } }

  .foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; margin-top: 4rem; font-family: var(--font-display); font-size: .9rem; }
  .foot a { color: rgba(255,255,255,.55); text-decoration: none; }
  .foot a:hover { color: #fff; }
</style>
