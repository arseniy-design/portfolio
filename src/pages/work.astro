---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import WRITING from '../data/writing.json';

export const prerender = true;

// One page to send to a stranger. A dark gallery: every project is a tile
// with its own screenshot and its name. Nothing else. One scroll.
// Two tiles are live: the WhatsApp chat plays its videos in place, and the
// teaching tile pops out the full course list.

const ext = { target: '_blank', rel: 'noopener' };

const MAIN = [
  { name: 'Finance Lessons',          meta: 'AI tutor · 42 filmed lessons',        shot: '/shots/lessons.webp',         href: '/lessons' },
  { name: 'Capital Markets Hub',      meta: 'Live tool · 22 activities',           shot: '/shots/capital-markets.webp', href: '/capital-markets' },
  { name: 'AI-Powered Finance',       meta: 'IE Business School · Academic Director', shot: '/shots/ie-ai-finance.webp', href: 'https://www.ie.edu/lifelong-learning/programs/ai-powered-finance/', ext: true },
  { name: 'Finance Academy Navigator', meta: 'Client prototype · sample data',      shot: '/shots/navigator.webp',       href: 'https://claude.ai/code/artifact/baf9a827-77cd-4045-8950-6fa5e8720d73', ext: true },
  { name: 'Gate Check',               meta: 'Web app · Santander · try the demo',  shot: '/shots/gatecheck.webp',       href: 'https://si90-gate-check.vercel.app/demo', ext: true },
  { name: 'The War Room',             meta: 'Simulation · English and Arabic',     shot: '/shots/warroom.webp',         href: 'https://claude.ai/public/artifacts/b3f7ebf5-4457-4860-9436-ecd6483d46d5', ext: true },
  { name: 'Writing',                  meta: `${WRITING.length} pieces · since 2020`, shot: '/shots/writing.webp',      href: '/writing' },
];

// The three WhatsApp courses. Same three as the homepage phone.
const CHAT = [
  { vid: '1175515603', tag: 'AI',        name: 'Generative AI for Business Professionals' },
  { vid: '1175515477', tag: 'Analytics', name: 'Digital Analytics for Business Professionals' },
  { vid: '1175515542', tag: 'Wellbeing', name: 'Mental Health in the Digital Era' },
];

// The teaching stack, copied from the homepage's last work card. Each
// description is one line drawn from that course's syllabus in ~/IE Syllabi.
// Advanced Financial Management is FIN 342 at OSU; the last two lines are his own wording.
type Course = { n: string; s: string; d?: string };
const TEACHING: { name: string; line: string; courses: Course[] }[] = [
  { name: 'Finance', line: 'Built on the $1.6B book I managed at Baird, brought straight into the classroom.',
    courses: [
      { n: 'Capital Markets', s: '25 sessions', d: 'Debt, equity and derivatives: how each market works and how its securities are priced, taught on live data.' },
      { n: 'Corporate Finance', s: '15 sessions', d: 'From capital budgeting and cost of capital to valuation and dividend policy, built in Excel on current business cases.' },
      { n: 'Financial Consulting', s: '15 sessions', d: 'Students form consulting firms and solve a new client challenge every session, ending in a final recommendation.' },
      { n: 'AI-Powered Finance', s: '15 sessions', d: 'Executive program taking finance professionals from GenAI foundations to hands-on use cases and an action plan for their own organization.' },
      { n: 'Financial Markets & Fintech', s: '15 sessions', d: 'Macro, asset classes and portfolio construction alongside digital payments, robo-advisors and DeFi, with a trading simulation.' },
      { n: 'Advanced Financial Management', s: '15 sessions', d: 'Capital budgeting, cost of capital, capital structure and dividend policy, at the depth an entry-level corporate finance role expects. FIN 342 at Oregon State.' },
    ] },
  { name: 'Entrepreneurship & AI', line: 'Five ventures built from scratch across six countries. Founder experience, taught first-hand.',
    courses: [
      { n: 'Entrepreneurial Journey', s: '15 sessions', d: 'Fifteen sessions from idea to pitch: the problem, the customer, the business model, the numbers, and the deck to defend them.' },
      { n: 'Design Thinking', s: '8 sessions', d: 'Empathize, define, ideate, prototype, test: teams take a real pain point from their own department to a tested solution.' },
      { n: 'Customer Experience', s: '10 sessions', d: 'Human-centered design applied to customer experience, from empathy maps and personas to prototyped journeys.' },
      { n: 'AI as a Cofounder', s: '3 sessions', d: 'A design sprint where participants use AI to go from a problem they care about to an investor pitch deck.' },
      { n: 'Business Applications of AI', s: '12 sessions', d: 'Four weeks on putting AI to work across operations, finance, prototypes and design, ending in a team capstone on a real case.' },
      { n: 'AI for Productivity', s: '5 sessions', d: 'Five sessions to build a personal AI power stack: creation, interpretation, interface, discovery and automation.' },
    ] },
  { name: 'Behavioral Sciences', line: 'How bias shows up in professional decisions. Applied across finance, leadership, and AI adoption.',
    courses: [
      { n: 'Critical Skills for the Modern World', s: '15 sessions', d: 'Think clearly, decide on purpose, convince others and manage your emotions, trained through simulations and debate before the capstone.' },
      { n: 'Critical Thinking in the AI Era', s: '8 sessions', d: 'Ten days of debate, simulation and bias audits, stress-testing AI output and defending your thinking in front of a live panel.' },
      { n: 'Decision Making', s: '8 sessions', d: 'Frameworks for deciding under uncertainty, the cognitive biases that get in the way, and how to counter them.' },
      { n: 'Financial Behavior', s: '8 sessions', d: 'How your own brain and habits shape money decisions, then applied to budgeting, planning and automating your finances.' },
      { n: 'Complex Problem Solving', s: '5 sessions', d: 'Cross-functional teams take one real challenge from the first trend scan to a pitched transformation plan.' },
      { n: 'AI for Professors', s: 'Up to 5 sessions', d: 'AI tools as teaching assistants: professors build their own use cases for lesson design, feedback and student support.' },
    ] },
];
const courseCount = TEACHING.reduce((n, t) => n + t.courses.length, 0);

const BRIEFS = [
  { name: 'Delta Dossier',     meta: 'Pre-earnings deep dive', shot: '/shots/t-delta.webp',         href: '/delta-dossier/' },
  { name: 'Portfolio Risk',    meta: 'Scenario testing',       shot: '/shots/t-portfoliorisk.webp', href: '/portfolio-risk/' },
  { name: 'Macro Risks',       meta: 'Five risks, one page',   shot: '/shots/t-macro.webp',         href: '/macro-risks/' },
  { name: 'Hormuz Shock',      meta: 'Commodity markets',      shot: '/shots/t-hormuz.webp',        href: '/hormuz-shock/' },
  { name: 'Taif Market Entry', meta: 'Wellness tourism',       shot: '/shots/t-taif.webp',          href: '/taif-market-entry/' },
];

const PROGRAMS = [
  { name: 'RCU Scale-up Hub',             meta: 'Saudi Arabia · 2024', shot: '/shots/p-rcu.webp', pos: 'top left', href: '/rcu-scale-up-hub.pdf', ext: true },
  { name: 'SABAH Hub',                    meta: 'Azerbaijan',          shot: '/shots/p-sabah.webp',           href: 'https://sabahhub.com/', ext: true },
  { name: 'Changemakers Program',         meta: 'Switzerland',         shot: '/shots/p-changemakers.webp',    href: 'https://www.wyssacademy.org/en/changemakers-program', ext: true },
  { name: 'Science Connexion & Blue Lab', meta: 'Mexico',              shot: '/shots/p-scienceconnexion.webp', href: 'https://scienceconnexion.com/Convocatorias/SobreReto/6', ext: true },
  { name: 'Santander Innovators 90',      meta: 'Spain · 2026',        shot: '/shots/p-santander.webp',       href: 'https://app.santanderopenacademy.com/en/program/innovation-and-ai-experience-in-madrid', ext: true },
];

const total = MAIN.length + 2 + BRIEFS.length + PROGRAMS.length;
---

<Layout
  title="Work · Arseniy Goldberg"
  description="Everything Arseniy Goldberg built or runs, on one page: a finance tutor, a live capital markets hub, the AI-Powered Finance program at IE, prototypes, courses, programs, writing."
  ogImage="/shots/capital-markets.webp"
>
  <div class="page">
    <Nav current="work" tone="dark" />
    <header class="top">
      <h1>{total} things I built.<br /><em>Click any of them.</em></h1>
      <p>Finance professor at IE Business School, formerly at Baird. Every tile opens something real.</p>
    </header>

    <main>
      <h2>Tools and programs <small>9</small></h2>
      <ul class="grid main">
        {MAIN.slice(0, 6).map(t => (
          <li><a href={t.href} {...(t.ext ? ext : {})}>
            <img src={t.shot} alt={t.name} loading="lazy" />
            <span class="cap"><span class="name">{t.name}</span><span class="meta">{t.meta}</span></span>
          </a></li>
        ))}

        <!-- WhatsApp courses: the tile is the phone screen, videos play in place -->
        <li class="chat-tile" id="chat">
          <div class="chat-head">
            <span class="chat-avatar">AG</span>
            <span class="chat-who"><span class="name">Courses in a chat</span><span class="meta">Three WhatsApp courses · Rebundle</span></span>
          </div>
          <div class="chat-body">
            {CHAT.map(c => (
              <button type="button" class="bubble" data-vid={c.vid} aria-label={`Play ${c.name}`}>
                <span class="thumb">
                  <img src={`https://vumbnail.com/${c.vid}.jpg`} alt="" loading="lazy" />
                  <span class="play"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
                </span>
                <span class="bubble-row"><span class="pill">{c.tag}</span><span class="bubble-name">{c.name}</span></span>
              </button>
            ))}
          </div>
          <div class="chat-player" hidden>
            <div class="chat-slot"></div>
            <button type="button" class="chat-close" aria-label="Close video">×</button>
          </div>
        </li>

        <li><a href={MAIN[6].href}>
          <img src={MAIN[6].shot} alt={MAIN[6].name} loading="lazy" />
          <span class="cap"><span class="name">{MAIN[6].name}</span><span class="meta">{MAIN[6].meta}</span></span>
        </a></li>

        <!-- Teaching: opens the course list -->
        <li><button type="button" class="tile-btn" id="teach-open">
          <img src="/lecture-hall.jpg" alt="Arseniy Goldberg lecturing" loading="lazy" style="object-position:center 40%" />
          <span class="cap"><span class="name">The Teaching Stack</span><span class="meta">{courseCount} courses · 3 domains · 300+ sessions</span></span>
        </button></li>
      </ul>

      <h2>Market briefs <small>5</small></h2>
      <ul class="grid small">
        {BRIEFS.map(t => (
          <li><a href={t.href}>
            <img src={t.shot} alt={t.name} loading="lazy" />
            <span class="cap"><span class="name">{t.name}</span><span class="meta">{t.meta}</span></span>
          </a></li>
        ))}
      </ul>

      <h2>Innovation programs <small>5</small></h2>
      <ul class="grid small">
        {PROGRAMS.map(t => (
          <li><a href={t.href} {...(t.ext ? ext : {})}>
            <img src={t.shot} alt={t.name} loading="lazy" style={t.pos ? `object-position:${t.pos}` : undefined} />
            <span class="cap"><span class="name">{t.name}</span><span class="meta">{t.meta}</span></span>
          </a></li>
        ))}
      </ul>
    </main>

    <footer class="foot">
      <a href="mailto:arseniygoldberg1@gmail.com">arseniygoldberg1@gmail.com</a>
      <a href="https://www.linkedin.com/in/arseniygoldberg/" {...ext}>LinkedIn</a>
      <a href="/">arseniygoldberg.com</a>
    </footer>

    <dialog id="teach" aria-labelledby="teach-title">
      <div class="dlg-head">
        <div>
          <span class="brand">{courseCount} courses · 3 domains · 300+ sessions</span>
          <h3 id="teach-title">The Teaching Stack</h3>
        </div>
        <button type="button" class="dlg-close" id="teach-close" aria-label="Close">×</button>
      </div>
      <div class="domains">
        {TEACHING.map(t => (
          <section>
            <h4>{t.name}</h4>
            <p>{t.line}</p>
            <ul>
              {t.courses.map(c => (
                <li>
                  <span class="crow"><span>{c.n}</span><span class="sess">{c.s}</span></span>
                  {c.d && <span class="cdesc">{c.d}</span>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </dialog>
  </div>
</Layout>

<script>
  // Chat tile: play a Vimeo video inside the tile, close returns to the chat.
  const chat = document.getElementById('chat');
  if (chat) {
    const player = chat.querySelector('.chat-player') as HTMLElement;
    const slot = chat.querySelector('.chat-slot') as HTMLElement;
    chat.querySelectorAll<HTMLButtonElement>('.bubble').forEach(b => b.addEventListener('click', () => {
      slot.innerHTML = `<iframe src="https://player.vimeo.com/video/${b.dataset.vid}?autoplay=1&title=0&byline=0&portrait=0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
      player.hidden = false;
    }));
    chat.querySelector('.chat-close')?.addEventListener('click', () => { slot.innerHTML = ''; player.hidden = true; });
  }

  // Teaching tile: native dialog, Esc and backdrop click both close it.
  const dlg = document.getElementById('teach') as HTMLDialogElement | null;
  if (dlg) {
    document.getElementById('teach-open')?.addEventListener('click', () => dlg.showModal());
    document.getElementById('teach-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style>
  /* 2026-09-23: charcoal ground, Schibsted headlines, captions under the screenshots, deep red accent. */
  :global(body) { background: #1E1F22; }
  .page { min-height: 100vh; background: #1E1F22; color: #F4F3F0; padding: 0 0 3rem; }
  .top, main, .foot { max-width: 1120px; margin: 0 auto; padding-left: 40px; padding-right: 40px; }
  @media (max-width: 720px) { .top, main, .foot { padding-left: 20px; padding-right: 20px; } }

  .top { padding-top: 80px; padding-bottom: 48px; display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 32px; align-items: end; }
  @media (max-width: 720px) { .top { grid-template-columns: 1fr; padding-top: 44px; padding-bottom: 24px; } }
  .brand { font-family: var(--font-display); font-weight: 600; font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; color: #AEB1B6; text-decoration: none; }
  dialog .brand { color: #5E636B; }
  .top h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(44px, 5.4vw, 76px); line-height: 1.02; letter-spacing: -.035em; margin: 0; }
  .top h1 em { font-style: normal; color: #AEB1B6; }
  .top p { color: #AEB1B6; font-size: 1rem; max-width: 32ch; margin: 0; }

  h2 { font-family: var(--font-display); font-weight: 800; font-size: 28px; letter-spacing: -.03em; color: #F4F3F0; margin: 32px 0 28px; display: flex; justify-content: space-between; align-items: baseline; }
  h2 small { font-family: var(--font-body); font-size: 14px; font-weight: 600; letter-spacing: 0; color: #AEB1B6; }

  .grid { list-style: none; margin: 0 0 120px; padding: 0; display: grid; gap: 72px 22px; }
  .grid.main  { grid-template-columns: repeat(2, 1fr); }
  .grid.small { grid-template-columns: repeat(2, 1fr); gap: 64px 16px; }
  @media (min-width: 640px) {
    .grid.main  { grid-template-columns: repeat(3, 1fr); }
    .grid.small { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 960px) { .grid.small { grid-template-columns: repeat(5, 1fr); } }

  .grid a, .tile-btn, .chat-tile { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; border-radius: 12px; background: #28292D; box-shadow: 0 0 0 1px #36383C; text-decoration: none; color: #F4F3F0; border: 0; padding: 0; margin: 0; font: inherit; text-align: left; cursor: pointer; }
  .chat-tile { overflow: hidden; }
  .grid img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; border-radius: 12px; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .grid a:hover img, .tile-btn:hover img { transform: scale(1.03); }
  .cap { position: absolute; left: 0; right: 0; top: calc(100% + 12px); display: flex; flex-direction: column; gap: 2px; }
  .name { font-family: var(--font-body); font-weight: 700; font-size: 17px; line-height: 1.25; }
  .meta { font-size: 14px; color: #AEB1B6; }
  .grid.small .name { font-size: 15px; }
  .grid.small .meta { font-size: 12.5px; }
  @media (max-width: 639px) { .name { font-size: 15px; } .meta { font-size: 12.5px; } }

/* chat tile */
  .chat-tile { background: #0B141A; cursor: default; display: flex; flex-direction: column; }
  @media (max-width: 639px) { .chat-tile { grid-column: 1 / -1; aspect-ratio: auto; } .chat-body { overflow: visible; } }
  .chat-head { display: flex; align-items: center; gap: .6rem; padding: .65rem .9rem; background: #111B22; border-bottom: 1px solid rgba(255,255,255,.08); flex-shrink: 0; }
  .chat-avatar { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(140deg, #A8322D, #8E2A26); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: .7rem; flex-shrink: 0; }
  .chat-who { display: flex; flex-direction: column; min-width: 0; }
  .chat-who .name { font-size: 1rem; font-family: var(--font-display); }
  .chat-who .meta { font-size: .72rem; }
  .chat-body { flex: 1; min-height: 0; padding: .6rem .7rem; display: flex; flex-direction: column; gap: .45rem; background: #0B141A; background-image: radial-gradient(rgba(255,255,255,.025) 1px, transparent 1px); background-size: 12px 12px; overflow: hidden; }
  .bubble { display: grid; grid-template-columns: 4.2rem 1fr; gap: .5rem; align-items: center; align-self: flex-start; width: 92%; background: #202C33; border: 0; border-radius: 10px 10px 10px 3px; padding: .35rem; color: #E9EDEF; font: inherit; text-align: left; cursor: pointer; transition: background .2s; }
  .bubble:hover { background: #2A3942; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 11; border-radius: 6px; overflow: hidden; }
  .thumb img { position: static; width: 100%; height: 100%; object-fit: cover; transition: none; }
  .thumb .play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; border-radius: 50%; background: rgba(255,255,255,.95); color: #0B141A; display: flex; align-items: center; justify-content: center; padding-left: 2px; }
  .bubble-row { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .pill { align-self: flex-start; font-family: var(--font-display); font-size: .58rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 1px 6px; border-radius: 999px; background: rgba(168,50,45,.95); color: #fff; }
  .bubble-name { font-size: .78rem; line-height: 1.25; }
  .chat-player { position: absolute; inset: 0; z-index: 3; background: #000; }
  .chat-player[hidden] { display: none; }
  .chat-slot, .chat-slot :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .chat-close { position: absolute; top: .5rem; right: .5rem; z-index: 4; width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,.6); border: 1px solid rgba(255,255,255,.3); color: #fff; font-size: 1.1rem; line-height: 1; cursor: pointer; }

  /* teaching dialog */
  dialog { margin: auto; width: min(64rem, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); border: 0; border-radius: 14px; background: #FFFFFF; color: #111214; padding: 0; overflow: auto; box-shadow: 0 40px 100px rgba(0,0,0,.6); }
  dialog::backdrop { background: rgba(17,18,20,.7); }
  .dlg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1.75rem 2rem 0; }
  .dlg-head h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.9rem; line-height: 1.1; margin: .5rem 0 0; }
  .dlg-close { width: 36px; height: 36px; border-radius: 50%; background: var(--color-warm-200); border: 1px solid var(--color-warm-300); color: var(--color-navy-900); font-size: 1.3rem; line-height: 1; cursor: pointer; flex-shrink: 0; }
  .dlg-close:hover { background: var(--color-warm-300); }
  .domains { display: grid; gap: 0 2rem; padding: 1.5rem 2rem 2rem; }
  .domains section { display: grid; grid-row: span 8; }
  @media (min-width: 800px) {
    .domains { grid-template-columns: repeat(3, 1fr); }
    .domains section { grid-template-rows: subgrid; }
  }
  .domains section + section { margin-top: 2rem; }
  @media (min-width: 800px) { .domains section + section { margin-top: 0; } }
  .domains h4 { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: #A8322D; margin: 0 0 .4rem; }
  .domains p { font-size: .88rem; line-height: 1.5; color: var(--color-navy-500); margin: 0 0 1rem; }
  .domains ul { display: contents; }
  .domains li { display: flex; flex-direction: column; gap: .3rem; padding: .7rem 0; border-top: 1px solid var(--color-warm-300); }
  .domains li:last-child { border-bottom: 1px solid var(--color-warm-300); }
  .crow { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; font-family: var(--font-display); font-weight: 500; font-size: .95rem; }
  .cdesc { font-size: .82rem; line-height: 1.45; color: var(--color-navy-600); }
  .sess { font-size: .72rem; color: var(--color-navy-400); white-space: nowrap; }
  @media (max-width: 639px) { .dlg-head, .domains { padding-left: 1.25rem; padding-right: 1.25rem; } }

  .foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; margin-top: 4rem; font-family: var(--font-display); font-size: .9rem; }
  .foot a { color: #AEB1B6; text-decoration: none; }
  .foot a:hover { color: #fff; }
</style>
