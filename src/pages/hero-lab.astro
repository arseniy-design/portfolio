---
import Layout from '../layouts/Layout.astro';
// Scratch page for comparing hero directions. Not linked from anywhere.
// Copy is held constant across all four so design is the only variable.
const HEAD_A = "12 Years.";
const HEAD_B = "5 Continents.";
const HEAD_C = "One Obsession.";
const SUB    = "What drives human decisions.";
---
<Layout title="Hero directions — arseniygoldberg.com" noindex={true}>

  <style>
    .lab-tag {
      position: absolute; top: 0; left: 0; z-index: 40;
      background: #F4621F; color: #fff;
      font-family: var(--font-display); font-weight: 700;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      padding: 8px 18px;
    }
    .lab-note {
      background: #0D1B2A; color: rgba(255,255,255,0.6);
      font-family: var(--font-display); font-size: 0.8rem;
      padding: 14px 24px; text-align: center; letter-spacing: 0.02em;
    }
  </style>

  <!-- ============ 0. CURRENT ============ -->
  <section class="hero-bg min-h-screen flex items-center overflow-hidden relative">
    <span class="lab-tag">Current</span>
    <div class="absolute left-[8%] top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-orange-500/15 to-transparent hidden lg:block"></div>
    <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-8 pt-24 pb-16 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h1 class="text-white leading-[1.0] mb-7" style="font-family: var(--font-display)">
          <span class="block font-bold tracking-tight" style="font-size: clamp(2.8rem,6vw,4.5rem)">{HEAD_A}</span>
          <span class="block font-bold tracking-tight" style="font-size: clamp(2.8rem,6vw,4.5rem)">{HEAD_B}</span>
          <span class="block font-light mt-3" style="font-size: clamp(1.8rem,4vw,2.8rem); color: rgba(255,255,255,0.75)">{HEAD_C}</span>
        </h1>
        <p class="text-base font-medium mb-4" style="color:rgba(255,255,255,0.85)">{SUB}</p>
        <div class="flex gap-2 mb-10">
          {["Finance", "AI", "Education"].map(t => (
            <span class="text-xs font-bold px-3 py-1.5 rounded-full" style="background:rgba(244,98,31,0.15);color:#F4621F;border:1px solid rgba(244,98,31,0.35);font-family:var(--font-display)">{t}</span>
          ))}
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#" class="bg-orange-500 text-white font-semibold px-8 py-4 rounded-full text-sm" style="font-family: var(--font-display)">Let's Work Together</a>
          <a href="#" class="text-sm px-8 py-4 rounded-full font-semibold" style="font-family: var(--font-display); border: 1px solid rgba(255,255,255,0.35); color: rgba(255,255,255,0.85)">Explore Work ↓</a>
        </div>
      </div>
      <div class="relative hidden lg:flex justify-end">
        <div class="relative rounded-2xl overflow-hidden" style="width: 380px; aspect-ratio: 3/4; background: #162236">
          <img src="/hero.jpg" alt="Arseniy Goldberg" class="w-full h-full object-cover" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,27,42,0.5) 0%, transparent 60%)"></div>
        </div>
      </div>
    </div>
  </section>
  <p class="lab-note">Text left, photo card right. The layout most consulting sites use.</p>

  <!-- ============ A. THE ROOM ============ -->
  <section class="relative min-h-screen flex items-end overflow-hidden" style="background:#0D1B2A">
    <span class="lab-tag">A · The Room</span>
    <img src="/athens-panel.jpg" alt="Arseniy Goldberg on an AI panel in Athens"
      class="absolute inset-0 w-full h-full object-cover" style="object-position: 50% 38%" />
    <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(8,15,22,0.97) 0%, rgba(8,15,22,0.90) 34%, rgba(8,15,22,0.30) 66%, rgba(8,15,22,0.55) 100%)"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3" style="background: linear-gradient(to top, rgba(8,15,22,0.9), transparent)"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 pb-20 sm:pb-28 pt-32">
      <div class="max-w-3xl">
        <p class="mb-6 text-xs font-bold tracking-[0.3em] uppercase" style="font-family:var(--font-display);color:#F4621F">Panathēnea &nbsp;·&nbsp; Athens</p>
        <h1 class="text-white font-bold tracking-tight" style="font-family:var(--font-display); font-size:clamp(3rem,8vw,6.5rem); line-height:0.94">
          {HEAD_A}<br/>{HEAD_B}<br/><span style="color:rgba(255,255,255,0.55);font-weight:300">{HEAD_C}</span>
        </h1>
        <p class="mt-8 text-lg sm:text-2xl font-light max-w-xl" style="color:rgba(255,255,255,0.85)">{SUB}</p>
        <a href="#" class="inline-block mt-10 text-sm font-bold tracking-wide pb-2"
          style="font-family:var(--font-display);color:#fff;border-bottom:2px solid #F4621F">Let's work together &nbsp;→</a>
      </div>
    </div>
  </section>
  <p class="lab-note">The photograph carries the claim. No card, no chips, one link.</p>

  <!-- ============ B. EDITORIAL ============ -->
  <section class="relative min-h-screen flex items-center overflow-hidden" style="background:#FAFAF8">
    <span class="lab-tag">B · Editorial</span>
    <div class="absolute right-0 top-0 bottom-0 w-[46%] hidden lg:block overflow-hidden">
      <img src="/hero.jpg" alt="Arseniy Goldberg" class="w-full h-full object-cover" style="object-position: 50% 14%" />
    </div>
    <div class="absolute left-0 top-0 bottom-0 w-px hidden lg:block" style="left:54%;background:rgba(13,27,42,0.12)"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 py-24">
      <div class="lg:w-[56%]">
        <p class="mb-8 text-xs font-bold tracking-[0.3em] uppercase" style="font-family:var(--font-display);color:#F4621F">Professor &nbsp;·&nbsp; Consultant &nbsp;·&nbsp; Entrepreneur</p>
        <h1 class="font-bold tracking-tighter" style="font-family:var(--font-display);color:#0D1B2A;font-size:clamp(2.8rem,6.4vw,5rem);line-height:0.92">
          {HEAD_A}<br/>{HEAD_B}<br/>{HEAD_C}
        </h1>
        <div class="mt-10 flex items-start gap-6">
          <div style="width:56px;height:2px;background:#F4621F;margin-top:14px;flex-shrink:0"></div>
          <p class="text-xl sm:text-2xl font-light max-w-md" style="color:#2A3E56">{SUB}</p>
        </div>
        <a href="#" class="inline-block mt-12 text-sm font-bold tracking-wide pb-1"
          style="font-family:var(--font-display);color:#0D1B2A;border-bottom:2px solid #F4621F">Let's work together &nbsp;→</a>
      </div>
    </div>
  </section>
  <p class="lab-note">Light instead of navy. Type is the subject, the photo is cropped by the page edge.</p>

  <!-- ============ C. THE CLAIM ============ -->
  <section class="relative min-h-screen flex flex-col justify-between overflow-hidden" style="background:#080F16">
    <span class="lab-tag">C · The Claim</span>
    <div class="absolute inset-0 opacity-[0.5]" style="background: radial-gradient(ellipse 55% 45% at 78% 62%, rgba(244,98,31,0.16) 0%, transparent 62%)"></div>

    <div class="relative z-10 flex-1 flex items-center w-full max-w-7xl mx-auto px-6 sm:px-12 pt-28 pb-10">
      <div class="grid lg:grid-cols-[1.6fr_1fr] gap-16 items-end w-full">
        <div>
          <h1 class="font-light tracking-tight" style="font-family:var(--font-display);color:#fff;font-size:clamp(2.6rem,6.5vw,5.2rem);line-height:1.02">
            {SUB.replace('.', '')}<span style="color:#F4621F">.</span>
          </h1>
          <p class="mt-10 text-base sm:text-lg font-light max-w-lg leading-relaxed" style="color:rgba(255,255,255,0.55)">
            {HEAD_A} {HEAD_B} {HEAD_C}
          </p>
          <a href="#" class="inline-block mt-12 text-sm font-bold tracking-wide pb-2"
            style="font-family:var(--font-display);color:#fff;border-bottom:2px solid #F4621F">Let's work together &nbsp;→</a>
        </div>
        <div class="hidden lg:block">
          <div class="overflow-hidden" style="aspect-ratio:3/4;max-height:56vh;margin-left:auto;width:min(100%,340px)">
            <img src="/hero.jpg" alt="Arseniy Goldberg" class="w-full h-full object-cover" style="filter:grayscale(1) contrast(1.05);object-position:50% 18%" />
          </div>
        </div>
      </div>
    </div>

    <div class="relative z-10 border-t w-full" style="border-color:rgba(255,255,255,0.09)">
      <div class="max-w-7xl mx-auto px-6 sm:px-12 py-6 flex flex-wrap gap-x-10 gap-y-2 text-xs" style="font-family:var(--font-display);color:rgba(255,255,255,0.4)">
        <span>IE Business School</span><span>Oregon State University</span><span>Robert W. Baird &amp; Co.</span><span>Santander</span><span>PIF</span><span>Ministry of Finance, Saudi Arabia</span>
      </div>
    </div>
  </section>
  <p class="lab-note">Restraint. One sentence, a monochrome portrait, and the names doing the proving.</p>

</Layout>
