---
// Homepage, rebuilt 2026-09-23 from the approved prototype (~/site-unify-prototype/site.html).
// Rhythm: hero, numbers, about, Baird, journey, what I built, logos, Ministry, quotes, Athens, writing, the ask.
// Photos only where they prove the section after them; breaks are black and white, the hero is the one colour photo.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import '../styles/site.css';
import PIECES from '../data/writing.json';
import { ART, JOURNEY, QUOTES } from '../data/site';

const FORM = 'https://formspree.io/f/mgonnqob';

const BUILT = [
  { name: 'Finance Lessons',           meta: 'AI tutor · 42 filmed lessons',          shot: '/shots/lessons.webp',         href: '/lessons' },
  { name: 'Capital Markets Hub',       meta: 'Live tool · 22 activities',             shot: '/shots/capital-markets.webp', href: '/capital-markets' },
  { name: 'AI-Powered Finance',        meta: 'IE Business School · Academic Director', shot: '/shots/ie-ai-finance.webp',  href: 'https://www.ie.edu/lifelong-learning/programs/ai-powered-finance/', ext: true },
  { name: 'Finance Academy Navigator', meta: 'Client prototype · sample data',        shot: '/shots/navigator.webp',       href: 'https://claude.ai/code/artifact/baf9a827-77cd-4045-8950-6fa5e8720d73', ext: true },
  { name: 'Gate Check',                meta: 'Web app · Santander · try the demo',    shot: '/shots/gatecheck.webp',       href: 'https://si90-gate-check.vercel.app/demo', ext: true },
  { name: 'The War Room',              meta: 'Simulation · English and Arabic',       shot: '/shots/warroom.webp',         href: 'https://claude.ai/public/artifacts/b3f7ebf5-4457-4860-9436-ecd6483d46d5', ext: true },
  { name: 'Writing',                   meta: '64 pieces · since 2020',                shot: '/shots/writing.webp',         href: '/writing' },
  { name: 'Courses in a chat',         meta: 'Three WhatsApp courses · Rebundle',     art: 'chat',                         href: '/work#chat' },
  { name: 'The Teaching Stack',        meta: '3 domains · 300+ sessions',             art: 'stack',                        href: '/work' },
];

const LOGOS = [
  ['ie-university.png', 'IE University'], ['santander.png', 'Santander'], ['pif-mono.png', 'PIF'], ['nissan.png', 'Nissan'],
  ['stc.png', 'stc'], ['kyowa-kirin.png', 'Kyowa Kirin'], ['ministry-of-finance.png', 'Saudi Ministry of Finance'], ['zatca.png', 'ZATCA'],
  ['flir.png', 'FLIR'], ['texas-medical-center.png', 'Texas Medical Center'], ['elm.png', 'Elm'], ['virginia-tech.png', 'Virginia Tech'],
  ['oregon-state.png', 'Oregon State University'], ['tec-de-monterrey.webp', 'Tec de Monterrey'], ['wyss-academy.png', 'Wyss Academy'],
];

type Piece = { slug: string; title: string; date: string; topic: string; standalone: boolean };
const latest = (PIECES as Piece[]).slice().sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const cut = (s: string, n: number) => (s.length > n ? s.slice(0, n).replace(/\s+\S*$/, '') + '…' : s);
const ext = { target: '_blank', rel: 'noopener' };
---
<Layout>
  <div class="site">
    <Nav current="home" tone="dark" cta="#contact" />
    <Hero />

    <section class="statband"><div class="wrap"><div class="stats5">
      <div><b>$1.6B</b><span>AUM managed</span></div>
      <div><b>70+</b><span>Institutions served</span></div>
      <div><b>9</b><span>Ventures and programs built</span></div>
      <div><b>5</b><span>Teaching excellence awards</span></div>
      <div><b>5+</b><span>Continents</span></div>
    </div></div></section>

    <section class="wrap aboutc">
      <span class="label">About</span>
      <h2>The through line is decision-making <span>under pressure.</span></h2>
      <p>I'm a Founding Partner at Flow Strategy Consulting and Academic Director of AI-Powered Finance at IE Business School. It looks the same in a boardroom as it does in a lecture hall.</p>
      <a class="more" href="/writing/modern-finance-runs-against-human-nature">Read: Modern Finance Runs Against Human Nature</a>
    </section>

    <div class="cb"><img src="/baird-team.jpg" alt="The Baird practice, 2019" style="object-position:center 4%" loading="lazy" /><p>The practice, 2019 · Robert W. Baird &amp; Co. · $1.6B under management</p></div>

    <section class="journeyband"><div class="wrap">
      <div class="sec-head"><h2>Fifteen years.<br /><span>One line.</span></h2></div>
      <div class="jline">
        {JOURNEY.map((j, i) => (
          <button type="button" class="jstop" data-journey={i}><small>{j.y}</small><b>{j.t}</b><span class="n">{j.n}</span></button>
        ))}
      </div>
      <p class="jnote">Click a stop to open it.</p>
    </div></section>

    <section class="dk hscroll"><div class="hs-sticky">
      <div class="wrap hs-head">
        <h2>What I built.<br /><span>Click any of them.</span></h2>
        <div class="hs-ctl">
          <button type="button" class="hs-btn" id="hs-prev" aria-label="Previous projects">←</button>
          <button type="button" class="hs-btn" id="hs-next" aria-label="Next projects">→</button>
          <a class="ulink" href="/work">See all 19</a>
        </div>
      </div>
      <div class="hs-track" id="home-work">
        {BUILT.map(t => (
          <a class="wt" href={t.href} {...(t.ext ? ext : {})}>
            <div class="shot">{t.shot ? <img src={t.shot} alt="" loading="lazy" /> : <Fragment set:html={ART[t.art!]} />}</div>
            <div><b>{t.name}</b><small>{t.meta}</small></div>
          </a>
        ))}
      </div>
    </div></section>

    <section class="logoband" aria-label="Organizations I have worked with">
      <p class="label" style="text-align:center;color:var(--mute)">Trusted in classrooms and boardrooms on 5 continents</p>
      <div class="marquee"><div class="mq-track">
        {LOGOS.map(([f, n]) => <img src={`/logos/${f}`} alt={n} />)}
        {LOGOS.map(([f, n]) => <img src={`/logos/${f}`} alt="" aria-hidden="true" />)}
      </div></div>
    </section>

    <div class="cb"><img src="/speaking.jpg" alt="Financial Leaders Program, Ministry of Finance, Saudi Arabia" style="object-position:62% 40%" loading="lazy" /><p>Ministry of Finance · Saudi Arabia · Financial Leaders Program</p></div>

    <section class="dk band-pad"><div class="wrap qwrap">
      <span class="label">What people say</span>
      <blockquote id="q-text">{QUOTES[0][0]}</blockquote>
      <div class="qmeta">
        <p id="q-who"><b>{QUOTES[0][1]}</b> · {QUOTES[0][2]}</p>
        <div class="qnav"><button type="button" id="q-prev" aria-label="Previous quote">‹</button><span id="q-n">1 / {QUOTES.length}</span><button type="button" id="q-next" aria-label="Next quote">›</button></div>
      </div>
      <p class="awards"><b>5 Teaching Excellence Awards</b> · IE University · 2023–24 and 2024–25</p>
    </div></section>

    <div class="cb"><img src="/athens-panel.jpg" alt="AI panel at Panathēnea, Athens" style="object-position:center 38%" loading="lazy" /><p>Panathēnea · Athens · AI in Practice</p></div>

    <section class="wrap sec" style="padding-top:104px">
      <div class="sec-head"><h2>Six years<br /><span>of thinking out loud.</span></h2></div>
      {latest.map(p => (
        <a class="wrow" href={p.standalone ? `/writing/${p.slug}` : `/writing#${p.slug}`}>
          <small>{p.topic} · {fmt(p.date)}</small><b>{cut(p.title, 110)}</b><i>Read</i>
        </a>
      ))}
      <div class="seeall"><a class="ulink" href="/writing" style="border-color:var(--acc)">All {PIECES.length} pieces →</a></div>
    </section>

    <section class="dk band-pad" id="contact" style="margin-top:120px"><div class="wrap ending">
      <div class="gate" style="padding:0 0 88px;border-bottom:1px solid var(--hair)">
        <h2>Who are you here for?</h2>
        <div class="doors">
          <div class="door"><a class="btn" href="/services#organization">My team or company</a><small>Implement AI · Measure AI · Build · Speak</small></div>
          <div class="door"><a class="btn ghost" href="/services#individual">Just me</a><small>1:1 AI · Career · Personal brand · Money</small></div>
        </div>
      </div>
      <div class="talk" style="padding-top:88px">
        <div class="sec-head" style="margin:0"><h2>Or just<br /><span>write to me.</span></h2><p class="lede" style="margin-top:16px">Two sentences on the problem is enough. Add two times that suit you and I'll confirm one.</p></div>
        <form id="contact-form">
          <input type="hidden" name="_subject" value="Homepage enquiry" />
          <div class="pair">
            <div class="field"><label for="h-name">Your name</label><input id="h-name" name="name" required /></div>
            <div class="field"><label for="h-email">Your email</label><input id="h-email" name="email" type="email" required /></div>
          </div>
          <div class="field"><label for="h-msg">What is going on, in two sentences</label><textarea id="h-msg" name="message" rows="3"></textarea></div>
          <div class="field"><label for="h-times">Two times that suit you, with your time zone</label><input id="h-times" name="times" /></div>
          <button class="btn" type="submit" id="submit-btn">Send</button>
          <p class="done" id="form-success" hidden>Got it. I'll be in touch soon.</p>
        </form>
      </div>
    </div></section>

    <footer class="foot"><div class="wrap"><span>© 2026 Arseniy Goldberg</span><span><a href="/services">Services</a><a href="/writing">Writing</a><a href="https://www.linkedin.com/in/arseniygoldberg/" target="_blank" rel="noopener">LinkedIn</a></span></div></footer>
  </div>

  <div class="scrim" id="scrim" hidden></div>

  <div id="intro-modal" class="vmodal" hidden>
    <div class="vframe"><iframe id="intro-iframe" title="55-second intro" src="" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
    <button type="button" class="vclose" id="intro-close" aria-label="Close video">×</button>
  </div>
</Layout>

<script define:vars={{ JOURNEY, QUOTES, FORM }}>
  // Journey stops open a pop-up with the photo and the story of those years.
  const scrim = document.getElementById('scrim');
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  function openStop(i) {
    const j = JOURNEY[i];
    scrim.innerHTML = `<div class="sheet" role="dialog" aria-modal="true" aria-label="${esc(j.t)}">${j.img ? `<div class="ph"><img src="${j.img}" alt="${esc(j.cap || '')}"></div>` : ''}<div class="in">${j.cap ? `<small style="color:var(--mute);font-size:12.5px">${esc(j.cap)}</small>` : ''}<span class="label">${esc(j.y)}</span><h3>${esc(j.t)}</h3><p>${esc(j.d)}</p><p class="proof">${esc(j.p)}</p><div class="row"><button type="button" class="x" id="sheet-x">Close</button></div></div></div>`;
    scrim.hidden = false;
    document.getElementById('sheet-x').focus();
  }
  const closeSheet = () => { scrim.hidden = true; };
  document.querySelectorAll('[data-journey]').forEach((b) => b.addEventListener('click', () => openStop(+b.dataset.journey)));
  scrim.addEventListener('click', (e) => { if (e.target === scrim || e.target.id === 'sheet-x') closeSheet(); });

  // What I built: arrows move one tile; no scroll hijack.
  const track = document.getElementById('home-work');
  const prev = document.getElementById('hs-prev');
  const next = document.getElementById('hs-next');
  const state = () => { prev.disabled = track.scrollLeft <= 4; next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4; };
  const move = (d) => { const w = track.querySelector('.wt'); track.scrollBy({ left: d * ((w ? w.getBoundingClientRect().width : 400) + 28), behavior: 'smooth' }); };
  prev.addEventListener('click', () => move(-1));
  next.addEventListener('click', () => move(1));
  track.addEventListener('scroll', state, { passive: true });
  addEventListener('resize', state);
  state();

  // Quotes, one at a time.
  let qi = 0;
  const showQ = () => {
    const [t, n, r] = QUOTES[qi];
    document.getElementById('q-text').textContent = t;
    document.getElementById('q-who').innerHTML = `<b>${esc(n)}</b> · ${esc(r)}`;
    document.getElementById('q-n').textContent = `${qi + 1} / ${QUOTES.length}`;
  };
  document.getElementById('q-next').addEventListener('click', () => { qi = (qi + 1) % QUOTES.length; showQ(); });
  document.getElementById('q-prev').addEventListener('click', () => { qi = (qi - 1 + QUOTES.length) % QUOTES.length; showQ(); });

  // Intro video.
  const modal = document.getElementById('intro-modal');
  const iframe = document.getElementById('intro-iframe');
  const closeVideo = () => { modal.hidden = true; iframe.src = ''; document.body.style.overflow = ''; };
  document.getElementById('intro-open')?.addEventListener('click', () => {
    iframe.src = 'https://player.vimeo.com/video/1138054609?autoplay=1&title=0&byline=0&portrait=0&dnt=1';
    modal.hidden = false; document.body.style.overflow = 'hidden';
  });
  document.getElementById('intro-close').addEventListener('click', closeVideo);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeVideo(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeVideo(); closeSheet(); } });

  // Contact form: posts to Formspree and stays on the page.
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('submit-btn');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.textContent = 'Sending...'; btn.disabled = true;
    try {
      const res = await fetch(FORM, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      if (!res.ok) throw new Error();
      form.querySelectorAll('.field, .pair, button').forEach((el) => (el.style.display = 'none'));
      document.getElementById('form-success').hidden = false;
    } catch { btn.textContent = 'Send'; btn.disabled = false; }
  });
</script>

<style is:global>
  body { background: #1E1F22; }
  .vmodal { position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,.92); display: grid; place-items: center; padding: 16px; }
  .vmodal[hidden] { display: none; }
  .vframe { width: min(900px, 92vw); aspect-ratio: 16/9; border-radius: 16px; overflow: hidden; }
  .vframe iframe { width: 100%; height: 100%; border: 0; display: block; }
  .vclose { position: absolute; top: 20px; right: 24px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255,255,255,.12); color: #fff; font-size: 1.4rem; cursor: pointer; }
  a.wrow { color: inherit; text-decoration: none; }
  .door a.btn { width: 100%; }
</style>
