  <script is:inline>
    (function () {
      const track = document.getElementById('wtrack');
      const prev = document.getElementById('wprev');
      const next = document.getElementById('wnext');
      const prog = document.getElementById('wprog');
      if (!track) return;
      function step() {
        const card = track.querySelector('.scard');
        const cardW = card ? card.getBoundingClientRect().width + 16 : 400;
        return Math.max(cardW, Math.floor((track.clientWidth - 40) / cardW) * cardW);
      }
      function update() {
        const max = track.scrollWidth - track.clientWidth;
        if (prog) prog.style.width = Math.max(12, (max ? track.scrollLeft / max : 1) * 100) + '%';
        if (prev) prev.disabled = track.scrollLeft <= 4;
        if (next) next.disabled = track.scrollLeft >= max - 4;
      }
      if (prev) prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      if (next) next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
    (function () {
      const card = document.getElementById('teach-card');
      if (!card) return;
      const home = document.getElementById('teach-home');
      function show(id) {
        home.classList.toggle('hidden', !!id);
        card.querySelectorAll('.teach-detail').forEach(d => d.classList.toggle('hidden', d.dataset.detail !== id));
      }
      card.querySelectorAll('.tcourse').forEach(b => b.addEventListener('click', () => show(b.dataset.c)));
      card.querySelectorAll('.tback').forEach(b => b.addEventListener('click', () => show(null)));
      card.querySelectorAll('.ttab').forEach(b => b.addEventListener('click', () => {
        card.querySelectorAll('.ttab').forEach(x => x.classList.toggle('ttab-on', x === b));
        card.querySelectorAll('.tdomain').forEach(d => d.classList.toggle('hidden', d.dataset.domain !== b.dataset.dom));
      }));
    })();
    (function () {
      const first = document.querySelector('.phone-screen');
      const title = document.querySelector('.phone-title');
      if (first && title) title.textContent = first.dataset.name;
    })();
    (function () {
      const player = document.getElementById('phone-player');
      const slot   = document.getElementById('phone-player-slot');
      const close  = document.getElementById('phone-close');
      function stop() {
        if (!player) return;
        player.classList.add('hidden');
        if (slot) slot.innerHTML = '';
      }
      document.querySelectorAll('.phone-play').forEach(btn => {
        btn.addEventListener('click', () => {
          if (!player || !slot) return;
          slot.innerHTML = '<iframe src="https://player.vimeo.com/video/' + btn.dataset.vid +
            '?autoplay=1&title=0&byline=0&portrait=0&playsinline=1&dnt=1" ' +
            'style="position:absolute;inset:0;width:100%;height:100%;border:none" ' +
            'allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
          player.classList.remove('hidden');
        });
      });
      if (close) close.addEventListener('click', stop);
      document.querySelectorAll('.phone-dot').forEach(d => d.addEventListener('click', stop));
    })();
    document.querySelectorAll('.phone-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        const n = dot.dataset.dot;
        document.querySelectorAll('.phone-screen').forEach(sc => sc.classList.toggle('hidden', sc.dataset.screen !== n));
        const active = document.querySelector('.phone-screen:not(.hidden)');
        const title = document.querySelector('.phone-title');
        if (active && title) title.textContent = active.dataset.name;
        document.querySelectorAll('.phone-dot').forEach(d => {
          const on = d.dataset.dot === n;
          d.style.background = on ? '#F4621F' : '#EDE8DF';
          d.style.color = on ? '#fff' : '#5B7494';
        });
      });
    });
  </script>
