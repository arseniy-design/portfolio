<script>
  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.08 });
  revealEls.forEach(el => revealObserver.observe(el));

  // Counter animation
  const counters = document.querySelectorAll('.counter');
  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = parseInt(el.dataset.target || '0');
      const steps = 40;
      const increment = target / steps;
      let current = 0;
      const timer = setInterval(() => {
        current += increment;
        if (current >= target) { el.textContent = String(target); clearInterval(timer); }
        else { el.textContent = String(Math.floor(current)); }
      }, 1000 / steps);
      counterObserver.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach(c => counterObserver.observe(c));

  // Tab switching
  function switchTab(tab: string) {
    document.querySelectorAll('.tab-panel').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    const panel = document.getElementById('tab-' + tab);
    if (panel) { panel.classList.remove('hidden'); panel.classList.add('tab-panel'); }
    document.querySelector(`[data-tab="${tab}"]`)?.classList.add('active');
  }
  (window as any).switchTab = switchTab;


  // Work toggle

  // Award panel toggle
  (window as any).selectEngagement = function(val: string, btn: HTMLElement) {
    (document.getElementById('engagement-input') as HTMLInputElement).value = val;
    document.querySelectorAll('.engagement-btn').forEach((b: Element) => {
      (b as HTMLElement).style.background = 'rgba(255,255,255,0.06)';
      (b as HTMLElement).style.color = 'rgba(255,255,255,0.5)';
      (b as HTMLElement).style.borderColor = 'rgba(255,255,255,0.1)';
    });
    btn.style.background = 'rgba(244,98,31,0.15)';
    btn.style.color = '#F4621F';
    btn.style.borderColor = 'rgba(244,98,31,0.4)';
  };

  (window as any).toggleAward = function(year: string) {
    const panel = document.getElementById('award-panel-' + year);
    const btn = document.getElementById('award-btn-' + year);
    if (!panel || !btn) return;
    const isOpen = panel.style.display !== 'none';
    panel.style.display = isOpen ? 'none' : 'block';
    btn.textContent = isOpen ? 'View Awards' : 'Hide Awards';
  };

  // Capital Markets Journey accordion
  (window as any).toggleJourney = function(id: string) {
    const panel = document.getElementById(id);
    const idx = id.replace('cm-', '');
    const arrow = document.getElementById('cm-arrow-' + idx);
    if (!panel) return;
    const isOpen = panel.style.display !== 'none';
    panel.style.display = isOpen ? 'none' : 'block';
    if (arrow) arrow.style.transform = isOpen ? '' : 'rotate(180deg)';
  };

  // Vimeo phone player
  const vimeoScript = document.createElement('script');
  vimeoScript.src = 'https://player.vimeo.com/api/player.js';
  document.head.appendChild(vimeoScript);

  const vimeoPlayers: Record<string, any> = {};

  (window as any).playVimeoPhone = function(key: string) {
    const iframe = document.getElementById('vimeo-' + key) as HTMLIFrameElement;
    const overlay = document.getElementById('overlay-' + key) as HTMLElement;
    const controls = document.getElementById('controls-' + key) as HTMLElement;
    if (!iframe || !overlay) return;
    overlay.style.display = 'none';
    const tryPlay = () => {
      if ((window as any).Vimeo) {
        const player = new (window as any).Vimeo.Player(iframe);
        vimeoPlayers[key] = player;
        player.play();
        if (controls) controls.style.display = 'flex';
      } else {
        setTimeout(tryPlay, 100);
      }
    };
    tryPlay();
  };

  (window as any).seekVimeo = function(key: string, seconds: number) {
    const player = vimeoPlayers[key];
    if (!player) return;
    player.getCurrentTime().then((t: number) => {
      player.setCurrentTime(Math.max(0, t + seconds));
    });
  };

  (window as any).toggleVimeo = function(key: string) {
    const player = vimeoPlayers[key];
    const btn = document.getElementById('playpause-' + key);
    if (!player || !btn) return;
    player.getPaused().then((paused: boolean) => {
      if (paused) {
        player.play();
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      } else {
        player.pause();
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
      }
    });
  };

  // AI walkthrough videos (inline, native controls)
  (window as any).playAiVideo = function(key: string, vid: string) {
    const frame = document.getElementById('aivid-frame-' + key) as HTMLElement;
    if (!frame) return;
    // Replace entire card contents with iframe
    frame.onclick = null;
    frame.style.cursor = 'default';
    frame.innerHTML = `<iframe src="https://player.vimeo.com/video/${vid}?autoplay=1&title=0&byline=0&portrait=0&dnt=1" style="position:absolute;inset:0;width:100%;height:100%;border:none" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
  };

  // Intro video lightbox
  (window as any).openIntroVideo = function() {
    const modal = document.getElementById('intro-modal') as HTMLElement;
    const iframe = document.getElementById('intro-iframe') as HTMLIFrameElement;
    if (!modal || !iframe) return;
    iframe.src = 'https://player.vimeo.com/video/1138054609?autoplay=1&title=0&byline=0&portrait=0&dnt=1';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  };
  (window as any).closeIntroVideo = function(e?: MouseEvent) {
    if (e && (e.target as HTMLElement).closest('iframe')) return;
    const modal = document.getElementById('intro-modal') as HTMLElement;
    const iframe = document.getElementById('intro-iframe') as HTMLIFrameElement;
    if (!modal) return;
    modal.style.display = 'none';
    if (iframe) iframe.src = '';
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') (window as any).closeIntroVideo();
  });

  // Nav scroll effect
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => { navbar?.classList.toggle('scrolled', window.scrollY > 60); }, { passive: true });

  // Mobile menu
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => mobileMenu.classList.add('hidden')));

  // Testimonial carousel
  (function() {
    const track = document.getElementById('carousel-track');
    const dotsContainer = document.getElementById('carousel-dots');
    if (!track || !dotsContainer) return;
    const slides = track.children;
    const total = slides.length;
    let current = 0;
    let perView = 3;
    let autoTimer: ReturnType<typeof setInterval>;

    function getPerView() {
      if (window.innerWidth < 768) return 1;
      if (window.innerWidth < 1024) return 2;
      return 3;
    }
    function buildDots() {
      dotsContainer.innerHTML = '';
      const pages = Math.ceil(total / perView);
      for (let i = 0; i < pages; i++) {
        const d = document.createElement('button');
        d.className = 'w-2 h-2 rounded-full transition-colors ' + (i === 0 ? 'bg-orange-500' : 'bg-warm-200');
        d.onclick = () => goTo(i * perView);
        dotsContainer.appendChild(d);
      }
    }
    function updateDots() {
      const dots = dotsContainer.querySelectorAll('button');
      const page = Math.floor(current / perView);
      dots.forEach((d, i) => { d.className = 'w-2 h-2 rounded-full transition-colors ' + (i === page ? 'bg-orange-500' : 'bg-warm-200'); });
    }
    function goTo(index: number) {
      perView = getPerView();
      const max = total - perView;
      current = Math.max(0, Math.min(index, max));
      const pct = (100 / perView) * current;
      (track as HTMLElement).style.transform = `translateX(-${pct}%)`;
      Array.from(slides).forEach(s => { (s as HTMLElement).style.minWidth = (100 / perView) + '%'; });
      updateDots();
    }
    (window as any).carouselNext = () => { clearInterval(autoTimer); goTo(current + 1 < total - perView + 1 ? current + 1 : 0); autoTimer = setInterval((window as any).carouselNext, 5000); };
    (window as any).carouselPrev = () => { clearInterval(autoTimer); goTo(current > 0 ? current - 1 : total - perView); autoTimer = setInterval((window as any).carouselNext, 5000); };
    window.addEventListener('resize', () => { perView = getPerView(); buildDots(); goTo(0); });
    perView = getPerView(); buildDots(); goTo(0);
    autoTimer = setInterval((window as any).carouselNext, 5000);
  })();

  // Contact form — AJAX, stays on page
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formSuccess = document.getElementById('form-success');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.textContent = 'Sending...';
    submitBtn.disabled = true;
    try {
      const res = await fetch('https://formspree.io/f/mgonnqob', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      });
      if (res.ok) {
        form.querySelectorAll('input, textarea, button').forEach(el => (el as HTMLElement).style.display = 'none');
        formSuccess?.classList.remove('hidden');
      } else {
        submitBtn.textContent = 'Let\'s work together →';
        submitBtn.disabled = false;
      }
    } catch {
      submitBtn.textContent = 'Send Message →';
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  /* Work With Me: warm light ground, orange reserved for the one action */
  #work-with-me {
    --wwm-bg:#F4F1EC; --wwm-h:#0D1B2A; --wwm-sub:#3D5470;
    --wwm-rule:#DDD6CC; --wwm-label:#0D1B2A; --wwm-tease:#5B7494;
    --wwm-pill-bg:rgba(244,98,31,0.13); --wwm-pill:#c44e16; --wwm-accent:#F4621F;
  }
  #work-with-me { background: var(--wwm-bg); }
  #work-with-me .wwm-h2   { color: var(--wwm-h); }
  #work-with-me .wwm-sub  { color: var(--wwm-sub); }

  .doorgrid { border-top: 1px solid var(--wwm-rule); border-left: 1px solid var(--wwm-rule); }

  .door {
    border-right: 1px solid var(--wwm-rule);
    border-bottom: 1px solid var(--wwm-rule);
    background: none; cursor: pointer; transition: background 0.3s ease;
    display: flex; flex-direction: column; align-items: flex-start;
    justify-content: flex-start; text-align: left;
  }
  .door .doorpill  { background: var(--wwm-pill-bg); color: var(--wwm-pill); }
  .door .doorlabel { color: var(--wwm-label); }
  .door .doortease { color: var(--wwm-tease); }
  .door.is-featured { background: var(--wwm-accent); }
  .door .doorarrow { color: #F4621F; }
  .door.is-featured .doorpill  { background: rgba(13,27,42,0.20) !important; color: #0D1B2A !important; }
  .door.is-featured .doorlabel { color: #0D1B2A !important; }
  .door.is-featured .doortease { color: rgba(13,27,42,0.80) !important; }
  .door.is-featured .doorarrow { color: #0D1B2A; }
  .door:hover { background: var(--wwm-accent); }
  .door:hover .doorpill  { background: rgba(13,27,42,0.20) !important; color: #0D1B2A !important; }
  .door:hover .doorlabel { color: #0D1B2A !important; }
  .door:hover .doortease { color: rgba(13,27,42,0.80) !important; }
  .door:hover .doorarrow { color: #0D1B2A; opacity: 1; transform: translateX(4px); }
  .door.is-featured:hover { filter: brightness(0.92); }

  /* only ever one lit cell: the lead cell stands down while another is hovered */
  .doorgrid:has(.door:hover) .door.is-featured:not(:hover) { background: none; }
  .doorgrid:has(.door:hover) .door.is-featured:not(:hover) .doorpill  { background: var(--wwm-pill-bg) !important; color: var(--wwm-pill) !important; }
  .doorgrid:has(.door:hover) .door.is-featured:not(:hover) .doorlabel { color: var(--wwm-label) !important; }
  .doorgrid:has(.door:hover) .door.is-featured:not(:hover) .doortease { color: var(--wwm-tease) !important; }
  #door-panel { animation: doorpop 0.28s cubic-bezier(0.22,1,0.36,1); }
  @keyframes doorpop { from { opacity: 0; transform: translateY(14px) scale(0.985); } to { opacity: 1; transform: none; } }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('doors-data');
    if (!el) return;
    var DOORS = JSON.parse(el.textContent);
    var modal = document.getElementById('door-modal');
    var current = null;

    function openDoor(i) {
      var d = DOORS[i]; current = d;
      document.getElementById('m-pillar').textContent = d.pillar;
      document.getElementById('m-label').textContent = d.label;
      document.getElementById('m-where').textContent = d.where;
      document.getElementById('m-walk').textContent = d.walk;
      document.getElementById('m-proof').textContent = d.proof || '';
      var ol = document.getElementById('m-does'); ol.innerHTML = '';
      d.does.forEach(function (step, k) {
        var li = document.createElement('li');
        li.className = 'flex gap-3.5 text-white/80 leading-snug';
        li.style.fontSize = '1.12rem';
        var num = document.createElement('span');
        num.textContent = String(k + 1).padStart(2, '0');
        num.className = 'text-orange-500 text-base font-black flex-shrink-0';
        num.style.fontFamily = 'var(--font-display)';
        var txt = document.createElement('span'); txt.textContent = step;
        li.appendChild(num); li.appendChild(txt); ol.appendChild(li);
      });
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function closeDoor() { modal.style.display = 'none'; document.body.style.overflow = ''; }

    document.querySelectorAll('[data-door]').forEach(function (btn) {
      btn.addEventListener('click', function () { openDoor(Number(btn.getAttribute('data-door'))); });
    });
    document.getElementById('door-close').addEventListener('click', closeDoor);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeDoor(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDoor(); });
    var msg = document.getElementById('contact-message');
    var basePlaceholder = msg ? msg.getAttribute('placeholder') : '';

    function pickDoor(label) {
      document.getElementById('engagement-input').value = label;
      document.getElementById('door-echo-text').textContent = label;
      document.getElementById('door-echo').classList.remove('hidden');
      if (msg) msg.setAttribute('placeholder', 'A couple more details about "' + label + '"');
    }

    document.getElementById('door-echo-clear').addEventListener('click', function () {
      document.getElementById('engagement-input').value = 'Not specified';
      document.getElementById('door-echo').classList.add('hidden');
      if (msg) msg.setAttribute('placeholder', basePlaceholder);
      document.getElementById('work-with-me').scrollIntoView({ behavior: 'smooth' });
    });

    var other = document.getElementById('door-other');
    if (other) other.addEventListener('click', function () {
      document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
      setTimeout(function () {
        var n = document.getElementById('contact-name');
        if (n) n.focus({ preventScroll: true });
      }, 650);
    });

    document.getElementById('m-cta').addEventListener('click', function () {
      if (current) pickDoor(current.label);
      closeDoor();
      document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
      setTimeout(function () {
        var n = document.getElementById('contact-name');
        if (n) n.focus({ preventScroll: true });
      }, 650);
    });
  })();
</script>

<!-- Journey timeline -->
<style>
  /* ---------- stage ---------- */
  .stage { position: relative; }
  .stage svg { width: 100%; height: auto; display: block; overflow: visible; }

  .era { cursor: pointer; }
  .era .hit { fill: none; stroke: transparent; stroke-width: 36; pointer-events: stroke; }
  .era .seg {
    fill: none; stroke: #0D1B2A; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--d) linear var(--delay),
                stroke .35s ease, opacity .35s ease;
  }
  .era .node {
    fill: #0D1B2A; opacity: 0;
    transition: opacity .4s ease var(--delay), fill .35s ease;
  }
  .era .node.ring { fill: none; stroke: #F4621F; stroke-width: 1; opacity: 0; }
  .pivot .node { fill: #F4621F; }
  .era .hit[cx] { stroke: none; }
  .era .node.pulse { fill: #0D1B2A; transform-box: fill-box; transform-origin: center; }
  .journey.visible .era .node.pulse { animation: nodePulse 2.8s ease-out 2.4s infinite; }
  .journey.open .era[data-era="ny"].active .node.pulse { fill: #F4621F; }
  @keyframes nodePulse { 0% { transform: scale(1); opacity: .55; } 70%, 100% { transform: scale(2.4); opacity: 0; } }
  .rider { opacity: 0; transition: opacity .25s ease; }
  .journey.visible .rider { opacity: 1; transition-delay: .05s; }
  .journey.visible.arrived .rider { opacity: 0; transition-delay: 0s; }

  .journey.visible .era .seg { stroke-dashoffset: 0; }
  .journey.visible .era .node { opacity: 1; }
  .journey.visible .era .node.ring { opacity: .5; }

  /* hover: this era forward, the rest step back */
  .journey.visible:hover .era .seg,
  .journey.visible:hover .era .node { opacity: .35; }
  .journey.visible .era:hover .seg,
  .journey.visible .era:hover .node { opacity: 1; }

  /* active: active era in orange, the rest quiet */
  .journey.visible.open .era .seg,
  .journey.visible.open .era .node { opacity: .28; }
  .journey.visible.open .era.active .seg { stroke: #F4621F; opacity: 1; }
  .journey.visible.open .era.active .node { fill: #F4621F; opacity: 1; }
  .journey.visible.open .era.active .node.ring { fill: none; opacity: .5; }
  .journey.visible.open .era:hover .seg,
  .journey.visible.open .era:hover .node { opacity: .8; }

  .strand {
    position: absolute; transform: translate(-50%, -50%);
    font-family: var(--font-display); font-size: 12px; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase; color: #1E2E42;
    opacity: 0; transition: opacity .5s ease 1.5s, color .3s ease;
  }
  .journey.visible .strand { opacity: 1; }
  .era-label { opacity: 0; transition: opacity .45s ease var(--at, 0s), color .3s ease; }
  .journey.visible .era-label { opacity: 1; }
  .journey.visible.open .era-label { transition-delay: 0s; }
  .journey.open .strand.active { color: #F4621F; }

  /* ---------- labels ---------- */
  .labels { position: relative; height: 72px; margin-top: -8px; }
  .era-label {
    position: absolute; transform: translateX(-50%);
    background: none; border: none; padding: 6px 10px; cursor: pointer; text-align: center;
    white-space: nowrap; color: #0D1B2A; transition: color .3s ease, opacity .3s ease;
  }
  .era-label .name {
    display: block; font-family: var(--font-display); font-weight: 600;
    font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: #0D1B2A;
  }
  .era-label .years {
    display: block; font-family: var(--font-display); font-size: 12px; font-weight: 500;
    color: #5B7494; margin-top: 4px; letter-spacing: .04em;
  }
  .era-label .place {
    display: block; font-family: var(--font-display); font-size: 11px; font-weight: 500;
    color: #7D99B8; margin-top: 2px; letter-spacing: .06em;
  }
  .era-label:hover .name { color: #F4621F; }
  .journey.visible.open .era-label { opacity: .45; }
  .journey.open .era-label.active { opacity: 1; }
  .journey.open .era-label.active .name { color: #F4621F; }


  /* ---------- mobile rail ---------- */
  .journey-m { position: relative; padding-left: 4px; }
  .journey-m .era-label { opacity: 1; position: static; transform: none; transition: opacity .3s ease, color .3s ease; }
  .journey-m::before {
    content: ''; position: absolute; left: 9px; top: 12px; bottom: 12px; width: 2px;
    background: #0D1B2A; opacity: .25;
  }
  .rail-row {
    position: static; transform: none; display: grid; grid-template-columns: 12px 1fr;
    column-gap: 18px; text-align: left; width: 100%; padding: 12px 0;
  }
  .rail-row .dot { width: 12px; height: 12px; border-radius: 50%; background: #0D1B2A; align-self: center; grid-row: span 2; transition: background .3s; }
  .rail-row[data-era="ie"] .dot { background: #F4621F; }
  .rail-row .years { margin-top: 0; margin-bottom: 3px; color: #F4621F; font-weight: 600; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .rail-row .name { font-size: 14px; letter-spacing: .06em; }
  .journey-m.open .rail-row { opacity: .45; }
  .journey-m.open .rail-row.active { opacity: 1; }
  .journey-m.open .rail-row.active .name { color: #F4621F; }
  .journey-m.open .rail-row.active .dot { background: #F4621F; }

  /* ---------- drawer ---------- */
  .drawer {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows .55s cubic-bezier(.4,0,.2,1);
  }
  .drawer.open { grid-template-rows: 1fr; }
  .drawer-inner { overflow: hidden; position: relative; min-height: 0; }
  .stem {
    position: absolute; top: 0; width: 1px; height: 40px; background: #F4621F;
    left: var(--x, 50%); opacity: 0; transition: left .5s cubic-bezier(.4,0,.2,1), opacity .3s;
  }
  .drawer.open .stem { opacity: 1; animation: stemIn .45s cubic-bezier(.4,0,.2,1) both; }
  @keyframes stemIn { from { height: 0; } to { height: 40px; } }
  @media (max-width: 767px) { .stem { display: none; } }

  .panel { display: none; padding: 48px 0 56px; opacity: 0; transform: translateY(10px); }
  .panel.active { display: block; animation: panelIn .5s ease .15s forwards; }
  @keyframes panelIn { to { opacity: 1; transform: translateY(0); } }

  .eyebrow {
    display: block; font-family: var(--font-display); font-size: .75rem; font-weight: 700;
    letter-spacing: .2em; text-transform: uppercase; color: #F4621F; margin-bottom: .6rem;
  }
  .big {
    font-family: var(--font-display); font-weight: 900; color: #0D1B2A; line-height: 1;
    font-size: clamp(2rem,4vw,3rem); margin-bottom: .5rem;
  }
  .big-long { font-size: clamp(1.6rem,2.6vw,2.15rem); line-height: 1.05; }
  .mid {
    font-family: var(--font-display); font-weight: 900; color: #0D1B2A; line-height: 1;
    font-size: clamp(1.8rem,3vw,2.4rem); margin-bottom: .75rem;
  }
  .roles { display: grid; grid-template-columns: 3.2rem auto 1fr; column-gap: 18px; row-gap: 9px; align-items: baseline; font-family: var(--font-display); font-size: .875rem; }
  .roles .yr { color: #F4621F; font-weight: 700; font-size: .8rem; letter-spacing: .04em; }
  .roles .org { color: #0D1B2A; font-weight: 600; }
  .roles .role { color: #3D5470; }
  .roles-top { padding-bottom: 28px; margin-bottom: 32px; border-bottom: 1px solid #DDD6CC; }
  .rule { width: 42px; height: 3px; background: #F4621F; border-radius: 2px; margin-bottom: 1rem; }
</style>

<script>
  const journey = document.getElementById('journey')!;
  const journeyM = document.getElementById('journey-m')!;
  const drawer = document.getElementById('journey-drawer')!;
  const stem = document.getElementById('journey-stem')!;
  const stemX: Record<string,string> = { osu: '15.5%', baird: '41.3%', ie: '57.5%', bat: '76.5%', ny: '92%' };
  let current: string | null = null;

  function setActive(era: string | null) {
    current = era;
    document.querySelectorAll('[data-era]').forEach(el => el.classList.toggle('active', el.getAttribute('data-era') === era));
    document.querySelectorAll('.panel').forEach(p => p.classList.toggle('active', p.getAttribute('data-panel') === era));
    [journey, journeyM, drawer].forEach(el => el.classList.toggle('open', !!era));
    if (era) stem.style.setProperty('--x', stemX[era]);
    if (era && window.innerWidth < 640) setTimeout(() => drawer.scrollIntoView({ behavior: 'smooth', block: 'start' }), 600);
  }

  document.querySelectorAll('.era, .era-label, .strand').forEach(el => {
    el.addEventListener('click', () => {
      const era = el.getAttribute('data-era')!;
      setActive(current === era ? null : era);
    });
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setActive(null); });

  // draw the line when it scrolls into view
  new IntersectionObserver((entries, obs) => {
    entries.forEach(en => {
      if (!en.isIntersecting) return;
      journey.classList.add('visible');
      const ride = document.getElementById('journey-ride') as any;
      try { ride?.beginElement(); } catch (_) {}
      setTimeout(() => journey.classList.add('arrived'), 2000);
      obs.disconnect();
    });
  }, { threshold: 0.4 }).observe(journey);
</script>
