---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
const heroVariant = (Astro.url.searchParams.get('hero') || 'current').toLowerCase();
const altHero = ['a','b','c'].includes(heroVariant);
const lightHero = heroVariant === 'b';
---
<Layout>

  <!-- NAV -->
  <nav id="navbar" class={`fixed top-0 left-0 right-0 z-50 py-4 px-4 sm:px-8 ${lightHero ? "nav-on-light" : ""}`}>
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="#" class="flex items-center" aria-label="Arseniy Goldberg">
        <svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <text x="1" y="24" style="font-family: var(--font-display); font-weight: 700; font-size: 25px; fill: white; letter-spacing: 4px;">AG</text>
          <text x="53" y="24" style="font-family: var(--font-display); font-weight: 700; font-size: 25px; fill: #F4621F;">.</text>
        </svg>
      </a>
      <div class="hidden md:flex items-center gap-8">
        <a href="#work"        class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Work</a>
        <a href="#clients"     class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Clients</a>
        <a href="#brands"      class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Brands</a>
        <a href="#recognition" class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Recognition</a>
        <a href="#linkedin"    class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Writing</a>
        <a href="#contact" class="bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors" style="font-family: var(--font-display)">
          Let's Talk
        </a>
      </div>
      <button id="mobile-menu-btn" class="md:hidden text-white/60 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-navy-950/95 backdrop-blur-lg border-t border-white/10 px-4 py-5 flex flex-col gap-4">
      <a href="#work"        class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Work</a>
      <a href="#clients"     class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Clients</a>
      <a href="#brands"      class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Brands</a>
      <a href="#recognition" class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Recognition</a>
      <a href="#contact" class="bg-orange-500 text-white text-sm font-semibold px-5 py-3 rounded-full text-center transition-colors" style="font-family: var(--font-display)">Let's Talk</a>
    </div>
  </nav>


  <!-- HERO -->
  {altHero && <Hero variant={heroVariant} />}
  {!altHero && (
  <section class="hero-bg min-h-screen flex items-center overflow-hidden">
    <div class="absolute left-[8%] top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-orange-500/15 to-transparent hidden lg:block"></div>
    <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-8 pt-24 sm:pt-28 pb-16 sm:pb-24 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <h1 class="text-white leading-[1.0] mb-7" style="font-family: var(--font-display)">
          <span class="block font-bold tracking-tight" style="font-size: clamp(2.8rem,6vw,4.5rem)">12 Years.</span>
          <span class="block font-bold tracking-tight" style="font-size: clamp(2.8rem,6vw,4.5rem)">5 Continents.</span>
          <span class="block font-light mt-3" style="font-size: clamp(1.8rem,4vw,2.8rem); color: rgba(255,255,255,0.75)">One Obsession.</span>
        </h1>
        <p class="text-base font-medium mb-4 whitespace-nowrap" style="color:rgba(255,255,255,0.85)">What drives human decisions.</p>
        <div class="flex gap-2 mb-10">
          {["Finance", "AI", "Education"].map(t => (
            <span class="text-xs font-bold px-3 py-1.5 rounded-full" style="background:rgba(244,98,31,0.15);color:#F4621F;border:1px solid rgba(244,98,31,0.35);font-family:var(--font-display)">{t}</span>
          ))}
        </div>
        <div class="flex flex-wrap gap-3 mb-5">
          <a href="#contact" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-4 rounded-full transition-colors text-sm tracking-wide" style="font-family: var(--font-display)">
            Let's Work Together
          </a>
          <a href="#work" class="text-sm px-8 py-4 rounded-full transition-colors font-semibold" style="font-family: var(--font-display); border: 1px solid rgba(255,255,255,0.35); color: rgba(255,255,255,0.85)">
            Explore Work ↓
          </a>
        </div>
        <button onclick="openIntroVideo()" class="flex items-center gap-3 text-sm font-medium" style="font-family: var(--font-display); color: rgba(255,255,255,0.75); background:none; border:none; cursor:pointer; padding:0">
          <span style="width:36px;height:36px;background:rgba(244,98,31,0.2);border:1px solid rgba(244,98,31,0.5);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#F4621F"><path d="M8 5v14l11-7z"/></svg>
          </span>
          Watch a 55-second intro
        </button>
      </div>
      <div class="relative hidden lg:flex justify-end">
        <div class="relative rounded-2xl overflow-hidden" style="width: 380px; aspect-ratio: 3/4; background: #162236">
          <img src="/hero.jpg" alt="Arseniy Goldberg" class="w-full h-full object-cover object-center" />
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(13,27,42,0.5) 0%, transparent 60%)"></div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-28 pointer-events-none" style="background: linear-gradient(to top, #FAFAF8, transparent)"></div>
  </section>
  )}

  <!-- STATS BAR -->
  <section class="bg-warm-50 py-16 border-b border-warm-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-8">
      <!-- Row 1: 5 stats -->
      <div class="grid grid-cols-2 md:grid-cols-5 border-b border-warm-200 mb-0">
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="100">0</span><span class="text-orange-500">+</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Independent Projects</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-1 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="70">0</span><span class="text-orange-500">+</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Institutions Reached</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-2 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="300">0</span><span class="text-orange-500">+</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Sessions Delivered</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-3 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="5">0</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Teaching Excellence Awards</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-4">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="15">0</span><span class="text-orange-500">+</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Courses Designed</p>
        </div>
      </div>
      <!-- Row 2: 5 stats -->
      <div class="grid grid-cols-2 md:grid-cols-5">
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-5 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="5">0</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Ventures Launched</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-6 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="4">0</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Innovation Programs</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-7 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="5">0</span><span class="text-orange-500">+</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Continents</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-8 border-r border-warm-200">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)"><span class="counter" data-target="3">0</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">Languages</p>
          <p class="text-navy-300 text-xs mt-1" style="font-family: var(--font-display)">EN · RU · ES</p>
        </div>
        <div class="stat-item text-center px-4 md:px-6 py-7 reveal reveal-delay-9">
          <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)">$1.6<span class="text-orange-500">B</span></p>
          <p class="text-navy-400 text-sm mt-2" style="font-family: var(--font-display)">AUM Managed</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="pt-16 pb-24 bg-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-8">

      <!-- Bio -->
      <div class="mb-16 reveal">
        <div class="max-w-2xl">
          <div class="section-label">
            <span class="text-orange-500 text-xs font-semibold tracking-[0.2em] uppercase" style="font-family:var(--font-display)">About</span>
          </div>
          <p class="text-navy-700 leading-relaxed mb-4" style="font-size:clamp(1rem,1.6vw,1.15rem)">
            I'm a Founding Partner at Flow Strategy Consulting and Academic Director of AI-Powered Finance at IE Business School. My career runs across capital markets, venture building, and organizational consulting. The teaching came out of that work.
          </p>
          <p class="text-navy-500 leading-relaxed mb-4" style="font-size:clamp(0.95rem,1.4vw,1.05rem)">
            At Robert W. Baird I was a Senior Financial Consultant in private wealth management and corporate investment consulting, on the investment committee for 4 private and 40+ corporate portfolios, before moving into innovation and advisory work. Since then I've built and led programs in six countries, advised startups through growth and fundraising, and helped organizations from Fortune 500 firms to government ministries navigate AI — from strategy to implementation. When I teach, it's because I've done the work first.
          </p>
          <p class="text-navy-500 leading-relaxed" style="font-size:clamp(0.95rem,1.4vw,1.05rem)">
            The through line is decision-making under pressure. It looks the same in a boardroom as it does in a lecture hall.
          </p>
        </div>
      </div>

      <!-- THE JOURNEY -->
      <div class="mb-0 reveal">

        <!-- Toggle bar -->
        <div class="flex items-center gap-3 mb-8">
          <button id="journey-btn-finance" onclick="switchJourney('finance')"
            class="flex-1 text-center px-5 py-3 rounded-xl text-sm font-bold transition-all"
            style="font-family:var(--font-display);background:#0D1B2A;color:#fff;border:1px solid #0D1B2A">
            2014 – 2019 · Finance
          </button>
          <div class="flex-shrink-0 text-center px-4">
            <p class="text-[9px] font-bold tracking-[0.3em] uppercase mb-0.5" style="font-family:var(--font-display);color:rgba(244,98,31,0.8)">Career Pivot · 2020</p>
            <p class="text-xs font-medium text-navy-600 whitespace-nowrap" style="font-family:var(--font-display)">IE Business School · MBA</p>
          </div>
          <button id="journey-btn-bat" onclick="switchJourney('bat')"
            class="flex-1 text-center px-5 py-3 rounded-xl text-sm font-bold transition-all"
            style="font-family:var(--font-display);background:#F4F1EC;color:#5B7494;border:1px solid #EDE8DF">
            2020 – Now · Entrepreneurship
          </button>
        </div>

        <!-- Phase 1: Finance -->
        <div id="journey-panel-finance">
          <div class="bg-white rounded-2xl p-8 md:p-10 border border-warm-200">
            <div class="grid md:grid-cols-2">
              <!-- Left: headline + metrics -->
              <div class="border-b md:border-b-0 md:border-r border-warm-200 pb-7 md:pb-0 md:pr-10">
                <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-2" style="font-family:var(--font-display)">Robert W. Baird & Co. · Senior Financial Consultant · Jul 2015 – Dec 2019</span>
                <h3 class="font-black text-navy-900 leading-none mb-3" style="font-family:var(--font-display);font-size:clamp(2.2rem,4vw,3rem)">FINANCE</h3>
                <p class="text-navy-400 text-sm leading-snug mb-8 max-w-xs">Private Wealth Management and Corporate Investment Consulting. $1.6B in investment assets across private households, retirement funds, and corporate portfolios. On the investment committee for 4 private and 40+ corporate portfolios. Client objectives met in 90% of 100+ financial plans.</p>
                <div class="flex flex-wrap gap-8">
                  <div>
                    <p class="font-bold text-2xl text-navy-900" style="font-family:var(--font-display)">$1.6B</p>
                    <p class="text-xs text-navy-400 mt-0.5">AUM Managed</p>
                  </div>
                  <div>
                    <p class="font-bold text-2xl text-navy-900" style="font-family:var(--font-display)">100+</p>
                    <p class="text-xs text-navy-400 mt-0.5">Financial Plans · 90% Met</p>
                  </div>
                  <div>
                    <p class="font-bold text-2xl text-navy-900" style="font-family:var(--font-display)">50%</p>
                    <p class="text-xs text-navy-400 mt-0.5">Practice Growth</p>
                  </div>
                </div>
              </div>
              <!-- Right: client segments + asset classes -->
              <div class="pt-7 md:pt-0 md:pl-10 flex flex-col gap-7">
                <div>
                  <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-3" style="font-family:var(--font-display)">Client Segments</span>
                  <div class="flex flex-wrap gap-1.5">
                    {["Private Wealth", "Corporate Retirement", "Institutional", "Endowments & Trusts"].map(c => (
                      <span class="text-xs px-2.5 py-1 rounded-full" style="background:#F4F1EC;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)">{c}</span>
                    ))}
                  </div>
                </div>
                <div>
                  <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-3" style="font-family:var(--font-display)">Asset Classes</span>
                  <div class="flex flex-wrap gap-1.5">
                    {["Equities", "Fixed Income", "Real Estate", "Annuities", "Alternatives"].map(c => (
                      <span class="text-xs px-2.5 py-1 rounded-full" style="background:#F4F1EC;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)">{c}</span>
                    ))}
                  </div>
                </div>
                <div>
                  <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-3" style="font-family:var(--font-display)">Portfolio Strategies</span>
                  <div class="flex flex-wrap gap-1.5">
                    {["Aggressive", "Moderately Aggressive", "Conservative", "ETF Satellite"].map(c => (
                      <span class="text-xs px-2.5 py-1 rounded-full" style="background:#F4F1EC;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)">{c}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Phase 2: Build / Advise / Teach -->
        <div id="journey-panel-bat" class="hidden">
          <div class="bg-white rounded-2xl p-8 md:p-10 border border-warm-200">
            <div class="grid md:grid-cols-3">
              <div class="border-b md:border-b-0 md:border-r border-warm-200 pb-7 md:pb-0 md:pr-8">
                <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-2" style="font-family:var(--font-display)">01</span>
                <h3 class="font-black text-navy-900 leading-none mb-3" style="font-family:var(--font-display);font-size:clamp(1.8rem,3vw,2.4rem)">BUILD</h3>
                <p class="text-navy-400 text-sm leading-snug mb-5">Ventures built from scratch in Azerbaijan, Spain, and the US.</p>
                <div class="flex flex-wrap gap-1.5">
                  {["SABAH Hub", "Flow Strategy", "North"].map(c => (
                    <span class="text-xs px-2.5 py-1 rounded-full" style="background:#F4F1EC;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)">{c}</span>
                  ))}
                </div>
              </div>
              <div class="border-b md:border-b-0 md:border-r border-warm-200 py-7 md:py-0 md:px-8">
                <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-2" style="font-family:var(--font-display)">02</span>
                <h3 class="font-black text-navy-900 leading-none mb-3" style="font-family:var(--font-display);font-size:clamp(1.8rem,3vw,2.4rem)">ADVISE</h3>
                <p class="text-navy-400 text-sm leading-snug mb-5">Strategy to implementation. Built around real company challenges.</p>
                <div class="flex flex-wrap gap-1.5">
                  {["Kyowa Kirin", "IE Law School", "TEC de Monterrey", "Royal Commission for AlUla"].map(c => (
                    <span class="text-xs px-2.5 py-1 rounded-full" style="background:#F4F1EC;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)">{c}</span>
                  ))}
                </div>
              </div>
              <div class="pt-7 md:pt-0 md:pl-8">
                <span class="text-xs font-bold tracking-[0.2em] uppercase text-orange-500 block mb-2" style="font-family:var(--font-display)">03</span>
                <h3 class="font-black text-navy-900 leading-none mb-3" style="font-family:var(--font-display);font-size:clamp(1.8rem,3vw,2.4rem)">TEACH</h3>
                <p class="text-navy-400 text-sm leading-snug mb-5">Classrooms, boardrooms, briefing rooms. The standard doesn't change.</p>
                <div class="flex flex-wrap gap-1.5">
                  {["IE Business School", "Oregon State", "PIF Saudi Arabia", "STC"].map(c => (
                    <span class="text-xs px-2.5 py-1 rounded-full" style="background:#F4F1EC;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)">{c}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div><!-- close max-w container -->

    <!-- CINEMATIC BREAK — Baird team photo, full width -->
    <div class="relative overflow-hidden" style="height:65vh;min-height:420px">
      <img src="/baird-team.jpg" alt="Arseniy Goldberg at Robert W. Baird & Co." class="w-full h-full object-cover object-top" />
      <div class="absolute inset-0" style="background:linear-gradient(to right, rgba(13,27,42,0.75) 0%, rgba(13,27,42,0.3) 50%, rgba(13,27,42,0.5) 100%)"></div>
      <div class="absolute bottom-0 left-0 right-0 h-28" style="background:linear-gradient(to top, #F4F1EC, transparent)"></div>
      <div class="absolute top-0 left-0 right-0 h-20" style="background:linear-gradient(to bottom, #F4F1EC, transparent)"></div>
      <div class="absolute inset-0 flex items-end">
        <div class="max-w-6xl mx-auto px-4 sm:px-8 pb-12 w-full">
          <p class="text-xs font-medium tracking-[0.2em] uppercase" style="font-family:var(--font-display);color:rgba(255,255,255,0.45)">Robert W. Baird & Co. &nbsp;·&nbsp; Portland, Oregon</p>
        </div>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-8 pt-14"><!-- reopen max-w container -->

      <!-- THE WORK -->
      <div class="section-label reveal">
        <span class="text-orange-500 text-xs font-semibold tracking-[0.2em] uppercase" style="font-family:var(--font-display)">The Work</span>
      </div>

      <!-- Main toggle -->
      <div class="flex gap-3 mb-10 reveal">
        <button id="work-btn-classroom" onclick="switchWork('classroom')"
          class="px-6 py-3 rounded-xl text-sm font-bold transition-all"
          style="font-family:var(--font-display);background:#0D1B2A;color:#fff;border:1px solid #0D1B2A">
          In the Classroom
        </button>
        <button id="work-btn-field" onclick="switchWork('field')"
          class="px-6 py-3 rounded-xl text-sm font-bold transition-all"
          style="font-family:var(--font-display);background:#F4F1EC;color:#5B7494;border:1px solid #EDE8DF">
          In the Field
        </button>
      </div>

      <!-- CLASSROOM PANEL -->
      <div id="work-panel-classroom">

        <!-- Classroom sub-toggles -->
        <div class="flex gap-0 border-b border-warm-300 mb-8">
          <button id="classroom-btn-finance" onclick="switchClassroomSub('finance')"
            class="px-5 pb-3 pt-1 text-sm font-bold transition-all border-b-2 -mb-px"
            style="font-family:var(--font-display);color:#0D1B2A;border-bottom-color:#F4621F">
            Finance
          </button>
          <button id="classroom-btn-entrepreneurship" onclick="switchClassroomSub('entrepreneurship')"
