---
const chip = "text-xs px-2.5 py-1 rounded-full";
const chipStyle = "background:#fff;color:#2a3f55;border:1px solid #e8e4dc;font-family:var(--font-display)";
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const DOORS = [
  { pillar: "ADVISE", label: "Make AI actually pay off", proof: "PIF and Kyowa Kirin: 5 hours a week saved per person through GenAI workflows.", featured: true,
    tease: "Where AI actually earns.",
    where: "You've run pilots. A few demoed well. Nobody can say which one moved a number.",
    does: ["Map one real process decision by decision.","Mark each one keep, automate, or split, and price it.","Track adoption after launch, not just the launch."],
    walk: "A ranked list of what to automate and what to protect, with a measure your CFO accepts." },
  { pillar: "ADVISE", label: "Fix how the work gets done", proof: "Missed deadlines and fines down 25%. Project execution time cut in half.",
    tease: "Fewer loops, clear owners.",
    where: "The process made sense at half this size. Now approvals loop, nobody owns the call, and everything takes three meetings.",
    does: ["Trace how work actually moves, not the org chart version.","Find where decisions stall and who really owns them.","Rebuild the operating model around those decision rights."],
    walk: "A redesigned flow with clear ownership, and a plan your teams run without me." },
  { pillar: "ADVISE", label: "Prove it before you spend", proof: "Models and go-to-market delivered in half the allotted time. $2.7M secured in year three at SABAH.HUB.",
    tease: "Evidence before the spend.",
    where: "You have conviction and a deck. You do not yet have proof anyone will pay.",
    does: ["Build the financial model and pressure test every assumption.","Validate demand in the target market before the spend.","Shape the go-to-market around what the evidence says."],
    walk: "A model you can defend, evidence of real demand, and a plan you can fund." },
  { pillar: "BUILD", label: "Ship a product that works", proof: "Five products at Rebundle. NPS of 70, 15 B2B clients, 6,000+ users.",
    tease: "In your team's hands.",
    where: "The idea has been in a document for months. IT has a queue. Nobody has seen it work.",
    does: ["Take the highest-value candidate and build it.","Finance tools, classroom products, internal agents.","Put it in your team's hands and watch them use it."],
    walk: "Something running your team can use on Monday, instead of a specification." },
  { pillar: "BUILD", label: "Build an innovation program", proof: "Scaled one program to five. Santander, Tec de Monterrey, SABAH. $2.7M in year three.",
    tease: "Built on real problems.",
    where: "Leadership wants innovation. What exists is a hackathon and a slide.",
    does: ["Design the program and source the real problems.","Recruit the cohort and set the standard.","Run it, then grow it into the next cycle."],
    walk: "A program with outcomes you can point at. Built before, inside a bank." },
  { pillar: "BUILD", label: "A course students can't fake", proof: "GenAI in Finance at IE: rated 5.0 out of 5.0, NPS of 68.",
    tease: "Curriculum that holds up.",
    where: "The syllabus was written for a world before AI. Students can finish the assignments without learning anything.",
    does: ["Rebuild the curriculum and write the cases.","Design assessment AI cannot shortcut.","Brief the faculty who have to teach it."],
    walk: "A course that runs without me, and faculty who can defend it." },
  { pillar: "TEACH", label: "Get your team using AI", proof: "300+ educators through the adoption program, 73% completion.",
    tease: "Habits that stick.",
    where: "Your people have licenses and no habits. The tools sit unused, or get used badly.",
    does: ["They bring the work they actually do.","We rebuild part of it live, in their tools, on their files.","They leave with one thing they will use tomorrow."],
    walk: "A team that has used it on real work once, which is the only thing that changes behavior." },
  { pillar: "TEACH", label: "Speak at your next event", proof: "Five teaching excellence awards. 70+ institutions across five continents.",
    tease: "One they quote on Monday.",
    where: "You need a session people repeat afterward, not one they sit through.",
    does: ["Build the talk around your audience and the decision they face.","Finance, technology, and how people actually decide.","Leave them the uncomfortable question, not the summary."],
    walk: "A room that leaves with something to argue about." },
];

const STATS5 = [
  { n: "$1.6", suf: "B", label: "AUM Managed" },
  { n: "70",   suf: "+", label: "Institutions Served" },
  { n: "9",    suf: "",  label: "Ventures & Programs Built" },
  { n: "5",    suf: "",  label: "Teaching Excellence Awards" },
  { n: "5",    suf: "+", label: "Continents" },
];

// The slider: every card is a real, openable piece of work.
// Ordered by impressiveness. slice(0,2) renders before the phone card, slice(2) after.
