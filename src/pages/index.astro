---
<Layout>

  <!-- NAV -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 py-4 px-4 sm:px-8">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="#" class="flex items-center" aria-label="Arseniy Goldberg">
        <svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <text x="1" y="24" style="font-family: var(--font-display); font-weight: 700; font-size: 25px; fill: white; letter-spacing: 4px;">AG</text>
          <text x="53" y="24" style="font-family: var(--font-display); font-weight: 700; font-size: 25px; fill: #F4621F;">.</text>
        </svg>
      </a>
      <div class="hidden md:flex items-center gap-8">
        <a href="#work"        class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Work</a>
        <a href="#clients"     class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Clients</a>
        <a href="#brands"      class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Brands</a>
        <a href="#recognition" class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Recognition</a>
        <a href="#linkedin"    class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Writing</a>
        <a href="#work-with-me" class="text-white/60 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Work With Me</a>
        <a href="#contact" class="bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors" style="font-family: var(--font-display)">
          Let's Talk
        </a>
      </div>
      <button id="mobile-menu-btn" class="md:hidden text-white/60 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-navy-950/95 backdrop-blur-lg border-t border-white/10 px-4 py-5 flex flex-col gap-4">
      <a href="#work"        class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Work</a>
      <a href="#clients"     class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Clients</a>
      <a href="#brands"      class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Brands</a>
      <a href="#recognition" class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Recognition</a>
      <a href="#work-with-me" class="text-white/70 hover:text-white text-sm font-medium transition-colors" style="font-family: var(--font-display)">Work With Me</a>
      <a href="#contact" class="bg-orange-500 text-white text-sm font-semibold px-5 py-3 rounded-full text-center transition-colors" style="font-family: var(--font-display)">Let's Talk</a>
    </div>
  </nav>


  <!-- HERO -->
  <Hero />

  <!-- STATS BAR -->
  <section class="bg-warm-50 py-16 border-b border-warm-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-2 md:grid-cols-5">
        {STATS5.map((st, i) => (
          <div class={`stat-item text-center px-4 md:px-6 py-7 reveal ${i < 4 ? "md:border-r border-warm-200" : ""}`}>
            <p class="font-bold text-[2.5rem] text-navy-900 leading-none" style="font-family: var(--font-display)">{st.n}<span class="text-orange-500">{st.suf}</span></p>
            <p class="text-navy-400 text-sm mt-2 leading-snug md:min-h-[2.6em]" style="font-family: var(--font-display)">{st.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="pt-16 pb-24 bg-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-8">

      <!-- Bio -->
      <div class="mb-16 reveal">
        <div class="max-w-2xl">
          <div class="section-label">
            <span class="text-orange-500 text-xs font-semibold tracking-[0.2em] uppercase" style="font-family:var(--font-display)">About</span>
          </div>
          <p class="text-navy-600 leading-relaxed mb-5" style="font-size:clamp(1rem,1.45vw,1.08rem)">
            I'm a Founding Partner at Flow Strategy Consulting and Academic Director of AI-Powered Finance at IE Business School. My career runs across capital markets, venture building, and organizational consulting. The teaching came out of that work.
          </p>
          <p class="text-navy-600 leading-relaxed mb-5" style="font-size:clamp(1rem,1.45vw,1.08rem)">
            At Robert W. Baird I was a Senior Financial Consultant in private wealth management and corporate investment consulting, on the investment committee for 4 private and 40+ corporate portfolios, before moving into innovation and advisory work. Since then I've built and led programs in six countries, advised startups through growth and fundraising, and helped organizations from Fortune 500 firms to government ministries put AI to work, from strategy through implementation.
          </p>
          <p class="text-navy-600 leading-relaxed" style="font-size:clamp(1rem,1.45vw,1.08rem)">
            The through line is decision-making under pressure. It looks the same in a boardroom as it does in a lecture hall.
          </p>
        </div>
      </div>

      <!-- THE JOURNEY -->
      <div class="mb-0 reveal">
      <div class="mb-14">
        <span class="text-orange-500 text-xs font-semibold tracking-[0.2em] uppercase block mb-3" style="font-family:var(--font-display)">The Journey</span>
        <h2 class="font-bold text-navy-900 leading-tight" style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem)">Fifteen years. One line.</h2>
        <p class="text-navy-600 mt-5 max-w-xl leading-relaxed" style="font-size:clamp(1rem,1.4vw,1.1rem)">Four years learning markets. Four years running $1.6B at Baird. One year to rethink it. Five years building, advising, and teaching what came out of that. Now AI in finance, in New York. The question never changed: what drives behavior and decisions.</p>
      </div>

      <!-- ============ DESKTOP STAGE ============ -->
      <div id="journey" class="journey hidden sm:block">
        <div class="stage">
          <svg viewBox="0 -20 1000 280" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <!-- the whole route, for the traveling dot -->
            <path id="journey-route" d="M40 230 Q150 226 271 212 L556 176 C596 176 588 96 617 96 L905 30" fill="none" stroke="none"/>
            <!-- OSU 2011–2015 -->
            <g class="era" data-era="osu">
              <path class="hit" d="M40 230 Q150 226 271 212"/>
              <path class="seg" pathLength="1" d="M40 230 Q150 226 271 212" style="--d:.45s;--delay:0s;stroke-width:1.75"/>
              <circle class="node" cx="40" cy="230" r="3" style="--delay:0s"/>
            </g>
            <!-- Baird 2015–2019 -->
            <g class="era" data-era="baird">
              <path class="hit" d="M271 212 L556 176"/>
              <path class="seg" pathLength="1" d="M271 212 L556 176" style="--d:.5s;--delay:.45s;stroke-width:3.25"/>
              <circle class="node" cx="271" cy="212" r="4" style="--delay:.45s"/>
            </g>
            <!-- IE 2020–2021 (the bend) -->
            <g class="era pivot" data-era="ie">
              <path class="hit" d="M556 176 C596 176 588 96 617 96"/>
              <path class="seg" pathLength="1" d="M556 176 C596 176 588 96 617 96" style="--d:.3s;--delay:.95s;stroke-width:3.5"/>
              <circle class="node ring" cx="556" cy="176" r="11" style="--delay:1s"/>
              <circle class="node" cx="556" cy="176" r="5" style="--delay:.95s"/>
            </g>
            <!-- Entrepreneurship 2021–2026 (three strands) -->
            <g class="era" data-era="bat">
              <path class="hit" d="M617 96 C690 96 700 15 761 15 C822 15 850 30 905 30"/>
              <path class="hit" d="M617 96 L905 30"/>
              <path class="hit" d="M617 96 C690 96 700 125 761 125 C822 125 850 30 905 30"/>
              <path class="seg" pathLength="1" d="M617 96 C690 96 700 15 761 15 C822 15 850 30 905 30" style="--d:.75s;--delay:1.25s;stroke-width:2.75"/>
              <path class="seg" pathLength="1" d="M617 96 L905 30" style="--d:.75s;--delay:1.25s;stroke-width:2.75"/>
              <path class="seg" pathLength="1" d="M617 96 C690 96 700 125 761 125 C822 125 850 30 905 30" style="--d:.75s;--delay:1.25s;stroke-width:2.75"/>
              <circle class="node" cx="617" cy="96" r="4.5" style="--delay:1.25s"/>
            </g>
            <!-- New York 2026 – now -->
            <g class="era" data-era="ny">
              <circle class="hit" cx="905" cy="30" r="24" style="stroke:none;fill:transparent;pointer-events:all"/>
              <circle class="node pulse" cx="905" cy="30" r="7" style="--delay:2s"/>
              <circle class="node" cx="905" cy="30" r="7" style="--delay:2s"/>
            </g>
            <!-- the traveling dot -->
            <circle class="rider" r="5" fill="#F4621F">
              <animateMotion id="journey-ride" dur="2s" begin="indefinite" fill="freeze" calcMode="linear"
                keyPoints="0;0.252;0.564;0.678;1" keyTimes="0;0.225;0.475;0.625;1">
                <mpath href="#journey-route"/>
              </animateMotion>
            </circle>
          </svg>

          <!-- Strand names, along the strands -->
          <span class="strand" style="left:76.1%;top:5%"    data-era="bat">Build</span>
          <span class="strand" style="left:76.1%;top:24.5%" data-era="bat">Advise</span>
          <span class="strand" style="left:76.1%;top:58%"   data-era="bat">Teach</span>

        </div>

        <!-- Era labels, below the line -->
        <div class="labels">
          <button class="era-label" data-era="osu" style="left:15.5%;--at:.15s">
            <span class="name">Oregon State</span>
            <span class="years">2011 – 2015</span>
            <span class="place">Corvallis</span>
          </button>
          <button class="era-label" data-era="baird" style="left:41.3%;--at:.55s">
            <span class="name">Robert W. Baird</span>
            <span class="years">2015 – 2019</span>
            <span class="place">Portland</span>
          </button>
          <button class="era-label" data-era="ie" style="left:57.5%;--at:1s">
            <span class="name">IE Business School</span>
            <span class="years">2020 – 2021</span>
            <span class="place">Madrid</span>
          </button>
          <button class="era-label" data-era="bat" style="left:76.5%;--at:1.35s">
            <span class="name">Entrepreneurship</span>
            <span class="years">2021 – 2026</span>
            <span class="place">Six countries</span>
          </button>
          <button class="era-label" data-era="ny" style="left:92%;--at:2s">
            <span class="name">AI in Finance</span>
            <span class="years">2026 – Now</span>
            <span class="place">New York</span>
          </button>
        </div>
      </div>

      <!-- ============ MOBILE RAIL ============ -->
      <div id="journey-m" class="journey-m sm:hidden">
        {[
          ["osu","Oregon State","2011 – 2015 · Corvallis"],
          ["baird","Robert W. Baird","2015 – 2019 · Portland"],
          ["ie","IE Business School","2020 – 2021 · Madrid"],
          ["bat","Entrepreneurship","2021 – 2026 · Six countries"],
          ["ny","AI in Finance","2026 – Now · New York"],
        ].map(([id,name,years]) => (
          <button class="rail-row era-label" data-era={id}>
            <span class="dot"></span>
            <span class="years">{years}</span>
            <span class="name">{name}</span>
          </button>
        ))}
      </div>

      <!-- ============ PANELS ============ -->
      <div id="journey-drawer" class="drawer">
        <div class="drawer-inner">
          <div class="stem" id="journey-stem"></div>

          <!-- OSU -->
          <div class="panel" data-panel="osu">
            <div class="grid md:grid-cols-2">
              <div class="border-b md:border-b-0 md:border-r border-warm-300 pb-7 md:pb-0 md:pr-10">
                <span class="eyebrow">Oregon State University</span>
                <h3 class="big big-long">FINANCE &amp;<br/>INTERNATIONAL BUSINESS</h3>
                <p class="text-navy-400 text-sm mb-5" style="font-family:var(--font-display)">Bachelor of Science &nbsp;·&nbsp; 2011 &ndash; 2015</p>
                <p class="text-navy-600 text-sm leading-relaxed max-w-sm">Two subjects that never left. How money moves, and how people differ across borders.</p>
              </div>
              <div class="pt-7 md:pt-0 md:pl-10 flex flex-col justify-center">
                <span class="eyebrow mb-4">Internships</span>
                <div class="roles">
                  <span class="yr">2014</span><span class="org">Robert W. Baird &amp; Co.</span><span class="role">Private Wealth Management Intern</span>
                  <span class="yr">2014</span><span class="org">State Farm Insurance</span><span class="role">Marketing Intern</span>
                </div>
              </div>
            </div>
          </div>

          <!-- BAIRD (existing panel, box removed) -->
          <div class="panel" data-panel="baird">
            <div class="grid md:grid-cols-2">
              <div class="border-b md:border-b-0 md:border-r border-warm-300 pb-7 md:pb-0 md:pr-10">
                <span class="eyebrow">Robert W. Baird &amp; Co.</span>
                <h3 class="big">FINANCE</h3>
                <p class="text-navy-400 text-sm mb-6" style="font-family:var(--font-display)">Senior Financial Consultant &nbsp;·&nbsp; Jul 2015 &ndash; Dec 2019</p>
                <p class="text-navy-600 text-sm leading-relaxed mb-8 max-w-sm">Private wealth management and corporate investment consulting, across private households, retirement funds, and corporate portfolios. On the investment committee for 4 private and 40+ corporate portfolios, in a practice of four.</p>
